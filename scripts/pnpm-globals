#!/bin/zsh

packages=(
  ts-node@latest
  prettier@latest
  opencommit@latest
  chatgpt-cli@latest
  @fission-ai/openspec@latest
  npm-check-updates@latest
  # ad-hoc process runners for one-off dev loops outside a repo; anything
  # else project-level comes from the repo's own deps
  concurrently@latest
  nodemon@latest
  typescript@latest
  typescript-language-server@latest
  # language servers for Claude Code code intelligence (LSP plugins declare
  # them; binaries must be on PATH) — pairs with gopls (brew), rust-analyzer
  # (rustup), fish-lsp (below)
  bash-language-server@latest
  pyright@latest
  @playwright/mcp@latest
  # markdown → OOXML conversion in the office-files skill (md2exxo-report.sh, via MD2EXXO_MARKDOWN_IT)
  markdown-it@latest
  # Exxo agent credential tooling (agent-run / agent-tooling); private GH
  # Packages registry — needs the read PAT in ~/.npmrc, which
  # scripts/npmrc-render writes from 1Password ("[EXXO] github npm read PAT"
  # in Exxo Engineering); deps-up runs it before this script
  @exxo-labs/agent-tooling@latest
  # node CLIs kept off Homebrew: their formulae depend on Homebrew's `node`
  # (v26, banned — see scripts/brew-update), so they run on nvm's Node 24 here
  # fish language server (editor / Claude Code LSP)
  fish-lsp@latest
  # Vercel CLI
  vercel@latest
  # MongoDB shell
  mongosh@latest
)

pnpm i -g "${packages[@]}"
