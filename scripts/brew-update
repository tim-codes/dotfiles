#!/bin/zsh

brewDeps=(
  asciinema
  awscli
  bash
  bat
  btop
  # Cloud SQL Auth Proxy: IAM-authenticated, read-only checks against
  # exxo-platform-pg (e.g. billing ledger role/migration state) without
  # authorised networks.
  cloud-sql-proxy
  colordiff
  composer
  # macOS ships no timeout(1)/nproc/shuf, so Linux-written scripts and agent
  # tooling die with exit 127 rather than timing out. coreutils g-prefixes only
  # the names that would collide (gls, gdate, ...) and links everything else
  # under its normal name, so installing it is the whole fix. Deliberately no
  # libexec/gnubin on PATH — that swaps ls/cp/date/sed shell-wide.
  coreutils
  crane
  ctop
  diff-so-fancy
  docker-compose
  # Open XML SDK validation/editing of Office files (exxo-common office-files skill)
  dotnet
  fd
  fish
  fzf
  # Homebrew git ahead of Apple's /usr/bin/git on PATH: minimum supported git
  # is 2.54 (config-based hooks, `hook.<name>.*`); Apple Git lags behind.
  git
  gh
  glab
  glances
  # markdown rendering in the terminal: glow for prose, mdcat for table-heavy
  # docs (see the `md` fish function in src/.config/fish/common.fish)
  glow
  # canonical name; "gpg" is an old alias for the same formula
  gnupg
  # Go toolchain — Exxo platform infra (Cloud Run functions under exxo-infra/functions/)
  go
  # Go language server — completes the TS/Go/Rust LSP trio (typescript-language-server
  # lives in pnpm-globals, rust-analyzer is a rustup component in setup-macbook)
  gopls
  gradle
  helm
  htop
  httpie
  jq
  just
  k9s
  lazydocker
  lazygit
  # psql for the Cloud SQL proxy checks above. Keg-only: run it as
  # /opt/homebrew/opt/libpq/bin/psql rather than linking over anything.
  libpq
  lsd
  mdcat
  # Node version manager (replaced nvm). Node installs at a stable path,
  # ~/.local/share/mise/installs/node/24, that IntelliJ's interpreter config and
  # launchd can point at; fnm's per-shell multishell symlinks could not offer
  # that. Config: src/.config/mise/config.toml.
  mise
  mysql-client
  ncdu
  fastfetch
  neovim
  pandoc
  # pinned: h2gc-legacy requires 8.3. Must be linked AFTER composer, which pulls
  # in the unversioned php formula as a dependency and auto-links it on top.
  "php@8.3"
  pipx
  pmd
  pnpm
  # PowerShell 7 (pwsh) — host for the ExchangeOnlineManagement module (scripts/pwsh-modules)
  powershell
  # pdftoppm for rasterising PDF pages — Claude Code needs it to visually
  # inspect PDFs (e.g. verifying generated Exxo report renders)
  poppler
  # pinned interpreter for the gcloud CLI (see scripts/gcloud-setup) and the
  # pipx venvs (see scripts/pipx-packages); Python 3.14 breaks gcloud storage
  # with ssl.PROTOCOL_TLSv1 and ansible-core does not run on 3.15. Keeping it
  # listed stops a cleanup from removing the interpreter under those venvs.
  "python@3.12"
  # from pulumi's own tap (its homebrew/core formula conflicts with the tap one
  # and brew refuses to upgrade across taps)
  "pulumi/tap/pulumi"
  # redis-cli for inspecting the local secret cache (the cache itself runs as
  # a container; this is the client, not a server we run)
  redis
  # from pulumi's own tap — the fully-qualified name auto-taps on install
  "pulumi/tap/esc"
  ripgrep
  scdoc
  shellcheck
  # Ad-hoc socket/port relays (e.g. a short-lived LAN relay of a local Unix
  # socket). Not for anything long-running or unattended.
  socat
  stow
  telnet
  tldr
  tmux
  # NOT "tofu" — that name resolves to a cask for Tofu.app, an e-reader, which
  # is what this list silently installed for months while `tf` stayed broken
  opentofu
  tree
  webp
  websocat
  wget
  wireguard-tools
  worktrunk
  yq
  zoxide
)

# Path to the timestamp file
timestamp_file="/tmp/brew_update_timestamp"

# Function to check if brew update is needed
function should_update_brew {
  if [[ -f "$timestamp_file" ]]; then
    last_update=$(cat "$timestamp_file")
    current_time=$(date +%s)
    time_diff=$((current_time - last_update))
    if [[ $time_diff -lt 1200 ]]; then
      echo "Brew update was run less than 20 minutes ago. Skipping update."
      return 1
    fi
  fi
  return 0
}

# Check if brew update is needed
if should_update_brew; then
  echo "Running brew update..."
  brew update -q && brew upgrade
  date +%s > "$timestamp_file"
fi

# GUI apps and SDKs shipped as casks. Alacritty is deliberately absent — its
# cask is deprecated/unnotarized, so setup-macbook builds it from source.
# Format: "cask" or "cask:Bundle Name.app" when it installs an /Applications app.
brewCasks=(
  "1password-cli"
  # Microsoft dev tunnels CLI — stable per-developer tunnel URLs for cloud→local
  # callbacks (Cloud Tasks etc.); the exxo-common dev-tunnels skill drives it.
  "devtunnel"
  # display connection management for the shared Dell U4025QW — drops the
  # phantom TB display when the monitor switches to the other machine; see
  # homelab docs/workstation/desk-topology.md (connection mgmt is a Pro feature)
  "betterdisplay:BetterDisplay.app"
  "firefox:Firefox.app"
  "gcloud-cli"
  # dropdown/quick terminal only — Alacritty stays the daily driver. Ghostty is
  # the one of the two with a native quick-terminal, and keeping it off the
  # long-lived sessions sidesteps its known port-leak crash on multi-day uptime.
  # Themes are generated from the Alacritty ones by scripts/gen-ghostty-themes.
  "ghostty:Ghostty.app"
  "iterm2:iTerm.app"
  # headless docx/report rendering verification (soffice --convert-to pdf)
  "libreoffice:LibreOffice.app"
  # reverses scroll direction for non-Logitech mice only (config in
  # src/.config/linearmouse); Logi Options+ keeps owning the MX mice — see
  # docs/adr/2026-08-17-per-device-scroll-direction.md
  "linearmouse:LinearMouse.app"
  # the Docker engine on macOS (both machines) — replaces Docker Desktop, which
  # must not be installed alongside: it owns /var/run/docker.sock and the
  # /usr/local/bin/docker* symlinks, and its "desktop" credsStore helper
  # disappears with it (~/.docker/config.json uses "osxkeychain", which
  # OrbStack ships). OrbStack provides the CLI, compose and buildx plugins.
  "orbstack:OrbStack.app"
)

# homebrew dependencies
brew install $brewDeps

# Node 26 is banned (it SIGABRTs in native code inside ParsePackageJSON, which
# broke opencommit); Node comes from mise (24 only). Nothing above may depend on
# the unversioned `node` formula — node-based CLIs live in scripts/pnpm-globals.
# Covers the unversioned `node` and every versioned `node@N` formula (a stray
# `node@24` once sat next to nvm's 24 as a second runtime). Idempotent: no-op
# once removed. Uninstall fails loudly if something still depends on one.
for f in $(brew list --formula -1 | grep -E '^node(@[0-9]+)?$'); do
  brew uninstall "$f"
done

# composer pulls in the unversioned php formula and auto-links it, silently
# overriding php@8.3 above. Relink so the pinned version wins.
brew link "php@8.3" --force --overwrite

# casks. An app installed by hand — dragged from a .dmg, or carried across by
# Migration Assistant — is invisible to `brew list`, and `brew install --cask`
# on top of one aborts with "It seems there is already an App at ...". That
# would fail this script (and abort setup-macbook, which runs with `set -e`),
# so probe the bundle and leave such an app alone. Adopting it replaces the
# bundle and would discard a non-default install, so that stays manual:
#   brew install --cask --force <cask>
for entry in $brewCasks; do
  cask="${entry%%:*}"
  bundle="${entry#*:}"
  [[ "$bundle" == "$entry" ]] && bundle=""

  if brew list --cask "$cask" &>/dev/null; then
    echo "$cask: already installed"
  elif [[ -n "$bundle" && -d "/Applications/$bundle" ]]; then
    echo "$cask: $bundle present but not homebrew-managed — leaving as is"
  else
    brew install --cask "$cask"
  fi
done
