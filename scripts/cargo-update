#!/bin/zsh

cargoDeps=(
  bropages
)

# apps installed from git (not published to crates.io). SSH like every other
# clone; cargo needs the ssh:// URL form, not git@host:path
cargoGitDeps=(
  ssh://git@github.com/tim-codes/stray
  # alacritty theme switcher TUI - upstream main carries our configurable
  # alacritty-config-path fix (xdagiz/althemer#1, merged 2026-09-02; needed so
  # it rewrites the theme.toml indirection, not the stow-managed
  # alacritty.toml); move to crates.io `althemer` once a release > 0.3.0 ships
  ssh://git@github.com/xdagiz/althemer
)

# Keep the toolchain itself current first: nothing else updates rustup's
# stable channel, and it had drifted a year behind (1.88 -> 1.98) before this.
if command -v rustup >/dev/null; then
  rustup self update
  rustup update stable
fi

cargo install $cargoDeps

for repo in $cargoGitDeps; do
  # use the git CLI so ssh auth (1Password agent) works for private/rewritten remotes
  CARGO_NET_GIT_FETCH_WITH_CLI=true cargo install --git $repo
done