#!/bin/zsh

cargoDeps=(
  bropages
)

# apps installed from git (not published to crates.io)
cargoGitDeps=(
  https://github.com/tim-codes/stray
  # alacritty theme switcher TUI - our fork adds a configurable alacritty
  # config path (needed so it rewrites the theme.toml indirection, not the
  # stow-managed alacritty.toml); switch back to crates.io `althemer` once
  # https://github.com/xdagiz/althemer/pull/1 is merged and released
  https://github.com/tim-codes/althemer
)

cargo install $cargoDeps

for repo in $cargoGitDeps; do
  # use the git CLI so ssh auth (1Password agent) works for private/rewritten remotes
  CARGO_NET_GIT_FETCH_WITH_CLI=true cargo install --git $repo
done