#!/bin/zsh
set -eu -opipefail

source $HOME/.config/local.sh

# ~~~~ SETUP ~~~~ #
# ~~~~~~~~~~~~~~~ #

# install xcode command line tools
xcode-select --install || true

# create default zshrc file
touch ~/.zshrc

# install homebrew
if ! command -v /opt/homebrew/bin/brew &> /dev/null; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    echo 'PATH="/opt/homebrew/bin:$PATH"' >> ~/.zshrc
    source ~/.zshrc
fi

$DOTFILES_ROOT/scripts/brew-update

# setup .config sync with stow
cd $DOTFILES_ROOT && stow --target $HOME src
cd -
# chsh -s $(which fish)

cat <<EOF | fish

# if ! type -q fisher
  echo "Installing fisher"
  curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source \
    && fisher install jorgebucaran/fisher
# end
# update/install fisher_plugins from file
fisher update

# install powerline fonts
# see: https://github.com/powerline/powerline
if ! ls $HOME/Library/Fonts | grep -qi powerline
  git clone https://github.com/powerline/fonts.git powerline-fonts \
    && cd powerline-fonts \
    && ./install.sh \
    && cd - \
    && rm -rf powerline-fonts
end

EOF

# install poetry
pipx install poetry && pipx ensurepath

# install nvm
if ! command -v nvm &> /dev/null; then
  PROFILE=/dev/null bash -c 'curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh | bash'
  source $HOME/.nvm/nvm.sh
  nvm install $NODE_VERSION
  nvm use $NODE_VERSION
fi

# install claude code
# native installer (not brew cask) so it self-updates; installs to ~/.local/bin
if [[ ! -x $HOME/.local/bin/claude ]]; then
  curl -fsSL https://claude.ai/install.sh | bash
fi

# install rust
if ! command -v rustup &> /dev/null; then
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path
  source $HOME/.cargo/env
fi
rustup component add rust-analyzer

$DOTFILES_ROOT/scripts/cargo-update

# install compiled crcmod for gsutil (avoids slow checksumming)
# gcloud SDK uses its own python — install crcmod into that specific interpreter
GCLOUD_PYTHON="$(gcloud info --format='value(basic.python_location)' 2>/dev/null)" || true
if [[ -n "$GCLOUD_PYTHON" ]]; then
  "$GCLOUD_PYTHON" -m pip install --no-cache-dir crcmod 2>/dev/null || true
fi

# add fonts
$DOTFILES_ROOT/scripts/install-fonts-mac

# install alacritty terminal emulator
# built from source: the homebrew cask is deprecated (unnotarized, fails
# Gatekeeper) and is disabled from 2026-09-01; a locally-built app bundle
# carries no quarantine attribute so Gatekeeper never blocks it
ALACRITTY_VERSION="0.17.0"

# Gate on the version AND the supporting pieces, not just the presence of the
# app bundle. A Mac carrying the old cask build already has Alacritty.app, so a
# `! -d` guard skips it forever — leaving no `alacritty` terminfo entry (which
# ~/.tmux.conf's terminal-features line needs), no bin symlink and no
# completions. Those live in the source tree, so recovering any of them means
# re-cloning; the build is ~35s, so just redo the lot.
alacritty_current=""
if [[ -x /Applications/Alacritty.app/Contents/MacOS/alacritty ]]; then
  alacritty_current="$(/Applications/Alacritty.app/Contents/MacOS/alacritty --version | awk '{print $2}')"
fi
if [[ "$alacritty_current" != "$ALACRITTY_VERSION" ]] \
  || ! infocmp -1 alacritty >/dev/null 2>&1 \
  || [[ ! -L /opt/homebrew/bin/alacritty ]]; then
  alacritty_build_dir="$(mktemp -d)/alacritty"
  git clone --depth 1 --branch "v$ALACRITTY_VERSION" https://github.com/alacritty/alacritty.git "$alacritty_build_dir"
  (
    cd "$alacritty_build_dir"
    source $HOME/.cargo/env
    make app   # needs scdoc for the man pages — it is in brewDeps
    # Replace rather than `cp -r` over the top: copying into an existing
    # bundle merges the two and can leave stale files from the old version.
    rm -rf /Applications/Alacritty.app
    cp -r target/release/osx/Alacritty.app /Applications/
    ln -sf /Applications/Alacritty.app/Contents/MacOS/alacritty /opt/homebrew/bin/alacritty
    # Unprivileged tic writes to ~/.terminfo, which ncurses reads — including
    # over SSH, so remote sessions get a working TERM=alacritty too.
    tic -xe alacritty,alacritty-direct extra/alacritty.info
    cp extra/completions/alacritty.fish /opt/homebrew/share/fish/vendor_completions.d/ 2>/dev/null || true
  )
  rm -rf "$(dirname "$alacritty_build_dir")"
fi

# install tmux plugin manager + plugins from .tmux.conf
if [[ ! -d $HOME/.tmux/plugins/tpm ]]; then
  git clone https://github.com/tmux-plugins/tpm $HOME/.tmux/plugins/tpm
fi
$HOME/.tmux/plugins/tpm/bin/install_plugins

# override system bash
#rm /bin/bash
#ln -s /opt/homebrew/bin/bash /bin/bash
