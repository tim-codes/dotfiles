#!/bin/bash
# Converge ~/.tmux/plugins on exactly what ~/.tmux.conf declares. Safe to run
# any number of times, from any starting state:
#
#   - clones tpm if missing
#   - installs every declared plugin that is missing
#   - (--update) pulls every plugin to its latest
#   - removes plugins no longer declared (e.g. tmux-yank after it was dropped)
#   - (re)builds the rust plugins (tmux-agent-sidebar, tmux-home)
#
# Called by setup-macbook (install) and deps-up (--update). TPM's bin/ scripts
# are built for the command line and need no running tmux server.
set -euo pipefail

update=0
[ "${1:-}" = "--update" ] && update=1

command -v tmux >/dev/null || { echo "tmux-plugins: tmux not installed, skipping" >&2; exit 0; }

plugins="$HOME/.tmux/plugins"
tpm="$plugins/tpm"

if [ ! -d "$tpm" ]; then
  git clone git@github.com:tmux-plugins/tpm "$tpm"
fi

"$tpm/bin/install_plugins"
if [ "$update" = 1 ]; then
  "$tpm/bin/update_plugins" all
fi
"$tpm/bin/clean_plugins"

# Rust plugins are built here rather than by their own .tmux entry scripts:
# tmux-agent-sidebar pops an interactive install wizard when its binary is
# missing (and binds nothing that session), and tmux-home falls back to its
# bash popup until it is built. Build from source, not release binaries (same
# call as alacritty in setup-macbook). Always run, not only when the binary is
# missing: cargo is incremental, so this is a no-op when current and a rebuild
# after update_plugins moved the source.
[ -f "$HOME/.cargo/env" ] && source "$HOME/.cargo/env"
for rust_plugin in tmux-agent-sidebar tmux-home; do
  dir="$plugins/$rust_plugin"
  [ -f "$dir/Cargo.toml" ] || continue
  if command -v cargo >/dev/null; then
    cargo build --release --manifest-path "$dir/Cargo.toml"
  else
    echo "tmux-plugins: cargo not installed - $rust_plugin left unbuilt" >&2
  fi
done
