#!/bin/bash
set -eu -o pipefail

# Install base packages
sudo apt-get update
sudo apt-get install -y \
  zsh stow git curl vim \
  build-essential unzip \
  lsd bat fd-find ripgrep \
  tmux htop tree

# Change default shell to zsh, unless the machine wants its native login
# shell kept (e.g. ragnar: a zsh login shell breaks the Ubuntu desktop
# session env — snap apps vanish from the menu; interactive use is fish
# via alacritty/tmux regardless). Set DOTFILES_SKIP_CHSH=1 to opt out.
if [[ "${DOTFILES_SKIP_CHSH:-}" != "1" && "$SHELL" != */zsh ]]; then
  chsh -s $(which zsh)
fi

# Markdown renderers used by the `md` shell function (glow for prose, mdcat for
# table-heavy docs). Neither is reliably in the Ubuntu archive across the
# releases these machines run, so each gets a fallback rather than being added
# to the apt list above (a missing name there fails the whole install):
#   - glow ships from Charm's own apt repo
#   - mdcat is in newer archives only; cargo builds it everywhere else
if ! command -v glow &> /dev/null; then
  sudo mkdir -p /etc/apt/keyrings
  curl -fsSL https://repo.charm.sh/apt/gpg.key \
    | sudo gpg --dearmor -o /etc/apt/keyrings/charm.gpg
  echo "deb [signed-by=/etc/apt/keyrings/charm.gpg] https://repo.charm.sh/apt/ * *" \
    | sudo tee /etc/apt/sources.list.d/charm.list > /dev/null
  sudo apt-get update
  sudo apt-get install -y glow
fi

if ! command -v mdcat &> /dev/null; then
  sudo apt-get install -y mdcat \
    || cargo install mdcat \
    || echo "mdcat not installed (no archive package, no cargo) — skipping"
fi
