#!/bin/bash
# Launch a Claude Code session from a kickoff prompt file: read its frontmatter,
# cd to the working directory, and exec claude in the right account context with
# the stated model and effort. It is the ONLY launcher the squad herder calls
# (docs/superpowers/specs/2026-10-25-squad-herder-design.md in tim-codes/squad,
# section 4.3), so the interface and exit codes below are a stable contract.
#
#   claude-kickoff <prompt.md> [--account CONTEXT]
#                              [--resume <session_id> --cwd <dir>] [--dry-run]
#                              [--no-trust-check]
#   claude-kickoff --check-trust <cwd> --account CONTEXT
#
# The context wrappers (claude-personal, claude-exxo, claude-exxo-personal,
# claude-exxo-openrouter) are
# fish functions (src/.config/fish/common.fish, __claude_ctx), not executables, so
# this does not call them. It reproduces their whole effect instead: `env
# CLAUDE_CONFIG_DIR=<context dir> claude ...`, plus the wrapper's guard that never
# starts a session in $HOME or a context dir (redirected to ~/claude). That is
# more robust than `fish -c`: no fish startup per launch, no second layer of
# argument quoting around a multi-kilobyte prompt body, no dependence on fish
# existing on the box, and exec replaces this process so the herder's pane runs
# claude directly.
#
# The contexts come from data: ~/.config/claude-kickoff/contexts.toml
# (src/.config/claude-kickoff/contexts.toml, $CLAUDE_KICKOFF_CONTEXTS overrides the
# path), read with yq v4. That table is the launcher's source of truth: a new
# context is one entry, plus a precondition command if it needs one. The fish
# wrappers and claude-sync's CONTEXTS still list contexts in code, so the table's
# names and the scrub list below must stay in step with them;
# tests/claude-kickoff.sh fails when they drift (the drift guard).
#
# Folder trust: Claude Code stops a fresh session at a "trust this folder?" dialog
# until a human accepts it, and it records the answer as `hasTrustDialogAccepted`
# on the cwd's entry in the `projects` map of <config dir>/.claude.json (keys are
# real paths). The launcher never accepts the dialog and never writes that file; it
# only CHECKS, so a member that would sit at the dialog is refused up front (exit 3,
# `trust: missing ...` on stderr) and the herder reports it rather than the member
# silently failing to join. The check runs by default on every launch, --dry-run
# included (the herder resolves with --dry-run, so that is where it sees the
# refusal); --no-trust-check skips it, for an attended launch. --check-trust <cwd>
# runs only the check, read-only, for the context --account names.
set -uo pipefail

CONTEXTS_FILE="${CLAUDE_KICKOFF_CONTEXTS:-$HOME/.config/claude-kickoff/contexts.toml}"
ROLES="client herder concierge orchestrator infra liaison"
# Env the wrapper unsets for every context except exxo-openrouter, whose overlay
# routes through OpenRouter; any other context must never inherit it.
OPENROUTER_ENV="ANTHROPIC_BASE_URL ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL ANTHROPIC_DEFAULT_FABLE_MODEL CLAUDE_CODE_SUBAGENT_MODEL"

usage() {
    cat <<'EOF'
Usage: claude-kickoff <prompt.md> [--account CONTEXT]
                                  [--resume <session_id> --cwd <dir>] [--dry-run]
                                  [--no-trust-check]
       claude-kickoff --check-trust <cwd> --account CONTEXT

Reads the frontmatter of <prompt.md>, changes to its cwd and execs claude in the
matching account context with --model and --effort from the file. A new session
gets the prompt body as its single positional argument; --resume continues an
existing session instead and passes no body.

Prompt file format: key: value lines, ended by the first line that is exactly
`---`; the body is everything after it. A leading `---` line (conventional YAML
frontmatter, closed by the second `---`) is accepted too. Keys used (others are
ignored; values may be long free text, only the first word of context, model and
effort is used):
  cwd      working directory; ~ is expanded. A bare name (no / or ~) is looked up as
           the git checkout of that name under ~/dev, at most three
           levels deep (the shallowest wins; a tie is an error).
  context  a context `name` in the contexts file (a trailing comment is ignored)
  model    passed as --model
  effort   passed as --effort
  Optional keys, all echoed by --dry-run (the herder's only source of launch facts):
  harness  must equal the context's harness (default claude-code; else exit 5)
  role     client (default) | herder | concierge | orchestrator | infra | liaison
  lifetime run | task; the default is task for a client, else run
  needs    comma or space separated; each one the file lists in `account_bound` must
           be in the context's `provides` (exit 9); other words are ignored with a
           warning. Only this key is read, never the `join:` line.
  capabilities, env-pass   comma lists, passed through to --dry-run for the herder
  add_dirs        comma or space separated paths (~ expanded), each passed as
                  --add-dir so the session may use them outside its cwd; each must
                  exist (else exit 3); a path cannot contain spaces
  deny            comma separated permission rules, each passed as --disallowedTools
                  (e.g. `Bash(curl:*)`); a rule cannot contain a comma
  before-launch   human steps first (`before launch` with a space is the same key)

Options:
  --account A     override the frontmatter context (any context name in the file);
                  required with --resume: the frontmatter context is not trusted then,
                  and the relaunch note names this context
  --resume ID     continue session ID in the context --account names, from the
                  member's live cwd (--cwd); the prompt becomes the fixed relaunch
                  note. --dry-run also prints resume: <id> and resume_group: <g>
                  (the context's group, `none` when it has none; only members of a
                  group may be resumed across contexts)
  --cwd DIR       the member's live working directory; required with --resume
                  (the frontmatter cwd is ignored then, and the frontmatter need
                  not carry one). Without --resume it has no effect.
  --dry-run       resolve and validate everything, print the plan (never the body,
                  only its size) and exit 0 without launching
  --no-trust-check
                  skip the folder-trust check (attended launch, where the human can
                  answer the dialog). Without it the launch is refused, exit 3, when
                  the cwd is not trusted in the context: `trust: missing <path> in
                  <context>` and what to do, on stderr; nothing is launched and the
                  trust file is never modified. Also honoured as
                  CLAUDE_KICKOFF_NO_TRUST_CHECK=1.
  --check-trust DIR
                  only check whether DIR is trusted in the --account context; no
                  prompt file. Prints `trust: ok <path> in <context>` and exits 0, or
                  `trust: missing <path> in <context>` plus the human step and exits
                  3 (exit 2 when <config dir>/.claude.json is missing or invalid).
                  ~ is expanded and the path resolved to a real path, as Claude Code
                  keys its projects map.
  -h, --help      this text

Environment set for claude: CLAUDE_CONFIG_DIR=<context dir>, and the context's `env`
table, each variable only where the caller has not set it. Outside an `openrouter`
context the OpenRouter routing variables are unset, as the wrappers do.
Preconditions also run under --dry-run (it validates everything but the launch).
--dry-run prints, after the plan, harness, account, role, lifetime, needs,
capabilities, provides, env_pass, before_launch and add_dirs (empty as `none`).

Exit codes (stable):
  0   launched (never returns: claude is exec'd) / --dry-run succeeded
  2   usage error: bad or missing argument, unknown --account, malformed --resume id;
      or the folder-trust check cannot read <config dir>/.claude.json (missing or
      not a JSON object)
  3   prompt file unusable: missing, unreadable, no `---` terminator, empty body
      for a new session, or an add_dirs path that is not a directory; or the cwd is
      not trusted in the context (folder-trust check; --check-trust uses this too)
  4   frontmatter lacks a required key (cwd, context, model or effort); the message
      names it
  5   invalid value: unknown context, a harness other than the context's, an unknown
      role or lifetime, or cwd that does not resolve to one directory
  6   the context's config dir (run scripts/claude-contexts) or the contexts file
      does not exist
  7   the claude binary, or yq, is not on PATH
  8   a context precondition failed (the message names the command, never its output)
  9   an `account_bound` need is not provided by the context
Nothing secret is ever printed; the prompt body is never printed.

tmux marker: when $TMUX_PANE is set, just before exec the launcher sets the pane
options @agent (the context's `agent` key: claude, or kimi for exxo-openrouter) and
@agent_model (the model passed to claude, a tier alias resolved via the context's
settings.json env ANTHROPIC_DEFAULT_<TIER>_MODEL when set; unset if none) for tmux-home.
tmux failures never block the launch; --dry-run prints the two commands instead.
EOF
}

die() { # die <code> <message...>
    local code="$1"; shift
    printf 'claude-kickoff: %s\n' "$*" >&2
    exit "$code"
}

prompt="" account="" resume="" resume_cwd="" dry=0 check_trust="" trust_check=1
[ "${CLAUDE_KICKOFF_NO_TRUST_CHECK:-}" = 1 ] && trust_check=0
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --account)
            [ $# -ge 2 ] || die 2 "--account needs a value (exxo, exxo-personal or personal)"
            account="$2"; shift 2 ;;
        --account=*) account="${1#--account=}"; shift ;;
        --resume)
            [ $# -ge 2 ] || die 2 "--resume needs a session id"
            resume="$2"; shift 2 ;;
        --resume=*) resume="${1#--resume=}"; shift ;;
        --cwd)
            [ $# -ge 2 ] || die 2 "--cwd needs a directory"
            resume_cwd="$2"; shift 2 ;;
        --cwd=*) resume_cwd="${1#--cwd=}"; shift ;;
        --dry-run) dry=1; shift ;;
        --no-trust-check) trust_check=0; shift ;;
        --check-trust)
            [ $# -ge 2 ] || die 2 "--check-trust needs a directory"
            check_trust="$2"; shift 2 ;;
        --check-trust=*) check_trust="${1#--check-trust=}"; shift ;;
        -*) die 2 "unknown option: $1 (see --help)" ;;
        *)
            [ -z "$prompt" ] || die 2 "only one prompt file is accepted (got '$prompt' and '$1')"
            prompt="$1"; shift ;;
    esac
done

[ -n "$prompt" ] || [ -n "$check_trust" ] || { usage >&2; exit 2; }
[ -z "$check_trust" ] || [ -z "$prompt" ] || die 2 "--check-trust takes no prompt file (got '$prompt')"
[ -z "$check_trust" ] || [ -n "$account" ] || die 2 "--check-trust needs --account (the context whose trust file to read)"

# --- contexts table (yq v4 reads the TOML) -------------------------------------
command -v yq >/dev/null 2>&1 || die 7 "yq is not on PATH (brew install yq)"
yq --version 2>/dev/null | grep -q 'version v4\.' || die 7 "yq is not mikefarah yq v4 (the Python yq will not do): $(yq --version 2>&1 | head -n1)"
[ -r "$CONTEXTS_FILE" ] || die 6 "contexts file not found or unreadable: $CONTEXTS_FILE"
ctx_get() { # ctx_get <name> <yq expression on the context>: scalar, or a list one per line
    NAME="$1" yq -p toml -oy ".context[] | select(.name == strenv(NAME)) | $2" "$CONTEXTS_FILE" 2>/dev/null
}
CONTEXTS=$(yq -p toml -oy '.context[].name' "$CONTEXTS_FILE" 2>/dev/null | tr '\n' ' ')
CONTEXTS="${CONTEXTS% }"
[ -n "$CONTEXTS" ] || die 6 "no [[context]] entries in $CONTEXTS_FILE"
expand_home() { # a leading ~ is the caller's $HOME
    case "$1" in "~") printf '%s' "$HOME" ;; "~/"*) printf '%s' "$HOME/${1#"~/"}" ;; *) printf '%s' "$1" ;; esac
}
case "$account" in
    "") ;;
    *) case " $CONTEXTS " in *" $account "*) ;; *) die 2 "unknown --account '$account' (expected one of: $CONTEXTS)" ;; esac ;;
esac
# trust_check_dir <context> <config dir> <dir>: is <dir> trusted in the context?
# Read-only. Prints `trust: ok ...` on stdout and returns 0; or `trust: missing ...`
# plus the human step on stderr and returns 3; or a message on stderr and returns 2
# when <config dir>/.claude.json is missing or not a JSON object. <dir> is resolved
# to a real path first (Claude Code keys `projects` by real path); a missing
# `projects` map or entry counts as not trusted.
trust_check_dir() {
    local c="$1" cdir="$2" dir tfile
    dir=$(expand_home "$3")
    dir=$(cd "$dir" 2>/dev/null && pwd -P || printf '%s' "$dir")
    tfile="$cdir/.claude.json"
    [ -r "$tfile" ] || { printf 'claude-kickoff: trust file %s is missing or unreadable (context %s)\n' "$tfile" "$c" >&2; return 2; }
    jq -e 'type == "object"' "$tfile" >/dev/null 2>&1 \
        || { printf 'claude-kickoff: trust file %s is not a valid JSON object (context %s)\n' "$tfile" "$c" >&2; return 2; }
    if [ "$(jq -r --arg p "$dir" '.projects // {} | .[$p].hasTrustDialogAccepted // false' "$tfile" 2>/dev/null)" = true ]; then
        printf 'trust: ok %s in %s\n' "$dir" "$c"
        return 0
    fi
    {
        printf 'trust: missing %s in %s\n' "$dir" "$c"
        printf 'open the folder once in %s and accept the trust dialog, or start the member attended\n' "$c"
    } >&2
    return 3
}
if [ -n "$check_trust" ]; then
    check_dir=$(expand_home "$check_trust")
    check_cfg=$(expand_home "$(ctx_get "$account" .config_dir)")
    trust_check_dir "$account" "$check_cfg" "$check_dir"
    exit $?
fi
if [ -n "$resume" ]; then
    case "$resume" in
        *[!A-Za-z0-9_-]*) die 2 "--resume id may only contain letters, digits, '-' and '_'" ;;
    esac
fi

[ -f "$prompt" ] && [ -r "$prompt" ] || die 3 "prompt file not found or unreadable: $prompt"

# --- frontmatter -------------------------------------------------------------
# Line numbers: the frontmatter occupies lines first..last, the body starts after
# the terminator. Fixture form has no opening `---`; the conventional form does.
first=1
IFS= read -r head1 <"$prompt" || true
if [ "$head1" = "---" ]; then first=2; fi
term=$(awk -v first="$first" 'NR >= first && $0 == "---" { print NR; exit }' "$prompt")
[ -n "$term" ] || die 3 "no '---' line ends the frontmatter in $prompt"

fm_get() { # fm_get <key>: first matching `key: value` line in the frontmatter
    awk -v first="$first" -v last="$term" -v key="$1" '
        NR < first || NR >= last { next }
        {
            i = index($0, ":")
            if (i == 0) next
            k = substr($0, 1, i - 1)
            if (k != key) next
            v = substr($0, i + 1)
            sub(/^[ \t]+/, "", v); sub(/[ \t\r]+$/, "", v)
            print v; exit
        }' "$prompt"
}
first_word() { # first whitespace-separated word of stdin
    awk '{ print $1; exit }'
}

cwd_raw=$(fm_get cwd)
context_raw=$(fm_get context)
model=$(fm_get model | first_word)
effort=$(fm_get effort | first_word)
needs_raw=$(fm_get needs)
harness_raw=$(fm_get harness | first_word)
role=$(fm_get role | first_word)
lifetime=$(fm_get lifetime | first_word)
capabilities_raw=$(fm_get capabilities)
env_pass_raw=$(fm_get env-pass)
add_dirs_raw=$(fm_get add_dirs)
deny_raw=$(fm_get deny)
before_launch_raw=$(fm_get before-launch)
[ -n "$before_launch_raw" ] || before_launch_raw=$(fm_get "before launch")

# On resume the member's live cwd (--cwd) replaces the frontmatter one: the file
# was written for the original launch and may point at a directory that no longer
# exists. The account must also come from the herder, not the file.
if [ -n "$resume" ]; then
    [ -n "$account" ] || die 2 "--resume needs --account (the relaunch note names the target context)"
    [ -n "$resume_cwd" ] || die 2 "--resume needs --cwd <dir> (the member's live working directory; the frontmatter cwd is not trusted)"
    cwd_raw="$resume_cwd"
else
    [ -n "$cwd_raw" ] || die 4 "frontmatter key 'cwd' is missing or empty in $prompt"
fi
[ -n "$account" ] || [ -n "$context_raw" ] || die 4 "frontmatter key 'context' is missing or empty in $prompt (or pass --account)"
[ -n "$model" ] || die 4 "frontmatter key 'model' is missing or empty in $prompt"
[ -n "$effort" ] || die 4 "frontmatter key 'effort' is missing or empty in $prompt"

# --- context -> config dir (mirrors claude-exxo / claude-exxo-personal / claude-personal)
ctx="$account"
[ -n "$ctx" ] || ctx=$(printf '%s\n' "$context_raw" | first_word)
case " $CONTEXTS " in
    *" $ctx "*) ;;
    *) die 5 "unknown context '$ctx' (expected one of: $CONTEXTS)" ;;
esac

# --- harness, role, lifetime -------------------------------------------------
ctx_harness=$(ctx_get "$ctx" .harness)
ctx_account=$(ctx_get "$ctx" .account)
ctx_provides=$(ctx_get "$ctx" '(.provides // []) | .[]' | tr '\n' ' ')
harness="${harness_raw:-claude-code}"
[ "$harness" = "$ctx_harness" ] || die 5 "harness '$harness' does not match context '$ctx' (harness '$ctx_harness')"
role="${role:-client}"
case " $ROLES " in *" $role "*) ;; *) die 5 "unknown role '$role' (expected one of: $ROLES)" ;; esac
if [ -z "$lifetime" ]; then
    if [ "$role" = client ]; then lifetime=task; else lifetime=run; fi
fi
case "$lifetime" in run|task) ;; *) die 5 "unknown lifetime '$lifetime' (expected run or task)" ;; esac

# --- needs: what the context cannot provide -----------------------------------
# An account_bound need is satisfied only by a context that provides it (claude.ai
# connectors follow the logged-in account; exxo-openrouter denies agent/run and the
# datadog and boards servers). Words the file does not list are ignored.
account_bound=$(yq -p toml -oy '(.account_bound // []) | .[]' "$CONTEXTS_FILE" 2>/dev/null | tr '\n' ' ')
for need in $(printf '%s\n' "$needs_raw" | tr ',[:upper:]' ' [:lower:]'); do
    [ "$need" = "agent/run" ] && need=agent-run
    case " $account_bound " in
        *" $need "*)
            case " $ctx_provides " in
                *" $need "*) ;;
                *) die 9 "needs '$need' but context $ctx does not provide it" ;;
            esac ;;
        *) printf 'claude-kickoff: warning: unknown need %s ignored\n' "'$need'" >&2 ;;
    esac
done
config_dir=$(expand_home "$(ctx_get "$ctx" .config_dir)")
[ -d "$config_dir" ] || die 6 "config dir $config_dir does not exist (run scripts/claude-contexts)"

# --- cwd ---------------------------------------------------------------------
case "$cwd_raw" in
    "~")   cwd="$HOME" ;;
    "~/"*) cwd="$HOME/${cwd_raw#"~/"}" ;;
    /*)    cwd="$cwd_raw" ;;
    */*)   die 5 "cwd '$cwd_raw' is neither absolute, ~-relative nor a bare checkout name" ;;
    *)
        # A bare name: the one git checkout of that name under ~/dev (depth <= 3).
        matches=()
        while IFS= read -r m; do
            [ -n "$m" ] && [ -e "$m/.git" ] && matches+=("$m")
        done < <(find "$HOME/dev" -maxdepth 3 \( -name node_modules -o -name .git \) -prune -o \
                      -type d -name "$cwd_raw" -print 2>/dev/null)
        [ "${#matches[@]}" -ge 1 ] || die 5 "cwd '$cwd_raw' matches no git checkout under ~/dev"
        # The shallowest checkout wins (a stale clone deeper down must not shadow
        # ~/dev/<name>); two at the same depth are ambiguous.
        best="" nbest=0 bestdepth=99
        for m in "${matches[@]}"; do
            d="${m//[^\/]/}"; d=${#d}
            if [ "$d" -lt "$bestdepth" ]; then best="$m"; bestdepth="$d"; nbest=1
            elif [ "$d" -eq "$bestdepth" ]; then nbest=$((nbest + 1)); fi
        done
        [ "$nbest" -eq 1 ] || die 5 "cwd '$cwd_raw' is ambiguous under ~/dev: ${matches[*]}"
        cwd="$best" ;;
esac
[ -d "$cwd" ] || die 5 "cwd '$cwd' is not a directory"
cwd=$(cd "$cwd" && pwd -P) || die 5 "cannot enter cwd '$cwd'"
# The wrappers never start a session in $HOME or a context dir (it would ask to
# trust the whole home directory); they redirect into ~/claude.
home_real=$(cd "$HOME" && pwd -P)
redirect=0
[ "$cwd" = "$home_real" ] && redirect=1
for c in $CONTEXTS; do
    c_dir=$(expand_home "$(ctx_get "$c" .config_dir)")
    [ "$cwd" = "$c_dir" ] || [ "$cwd" = "$(cd "$c_dir" 2>/dev/null && pwd -P)" ] && redirect=1
done
if [ "$redirect" -eq 1 ]; then
    mkdir -p "$home_real/claude" 2>/dev/null
    cwd="$home_real/claude"
fi

# --- add_dirs: each becomes --add-dir; they must exist ----------------------
add_dirs=()
for d in $(printf '%s\n' "$add_dirs_raw" | tr ',' ' '); do
    d=$(expand_home "$d")
    [ -d "$d" ] || die 3 "add_dirs path '$d' is not a directory (in $prompt)"
    add_dirs+=("$d")
done
add_dir_args=()
for d in "${add_dirs[@]+"${add_dirs[@]}"}"; do add_dir_args+=(--add-dir "$d"); done

# --- deny: each comma separated rule becomes --disallowedTools ----------------
deny_args=()
while IFS= read -r r; do
    r=$(printf '%s' "$r" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
    [ -n "$r" ] && [ "$r" != none ] && deny_args+=(--disallowedTools "$r")
done < <(printf '%s\n' "$deny_raw" | tr ',' '\n')

# --- claude binary -----------------------------------------------------------
claude_bin=$(command -v claude 2>/dev/null || true)
if [ -z "$claude_bin" ] && [ -x "$HOME/.local/bin/claude" ]; then claude_bin="$HOME/.local/bin/claude"; fi
[ -n "$claude_bin" ] || die 7 "claude is not on PATH (nor in ~/.local/bin)"

# --- body --------------------------------------------------------------------
mode=new body=""
if [ -n "$resume" ]; then
    mode=resume
    # `claude --resume <id> <prompt>` takes a positional prompt in interactive mode
    # (claude --help: "Usage: claude [options] [command] [prompt]"), so the relaunch
    # note travels with the resume and the member sees it as its first message.
    body="squad relaunch: you are now on context $ctx. Re-register under the same name (squad-join §2, same session), then follow squad-join §5 \`relaunch\`."
else
    # Same as `$(sed '1,/^---$/d' file)`: everything after the terminator, trailing
    # newlines trimmed by the command substitution.
    body=$(tail -n +"$((term + 1))" "$prompt")
    [ -n "$body" ] || die 3 "the prompt body (after the '---' line) is empty in $prompt"
fi

# --- folder trust: check only, never accept; before anything with side effects --
trust_line="skipped"
if [ "$trust_check" -eq 1 ]; then
    trust_line=$(trust_check_dir "$ctx" "$config_dir" "$cwd") || exit $?
    trust_line="${trust_line#trust: }"
fi

# --- preconditions: in order, output discarded, the first failure refuses -----
preconds=$(ctx_get "$ctx" '(.preconditions // []) | .[]') || die 6 "cannot read the preconditions of $ctx from $CONTEXTS_FILE"
while IFS= read -r cmd; do
    [ -n "$cmd" ] || continue
    sh -c "$cmd" >/dev/null 2>&1 || die 8 "precondition failed: $cmd (context $ctx)"
done <<<"$preconds"

# --- context env: set only where the caller has not -------------------------
ctx_env=$(ctx_get "$ctx" '(.env // {}) | to_entries | .[] | .key + "=" + .value') || die 6 "cannot read the env of $ctx from $CONTEXTS_FILE"
while IFS= read -r kv; do
    [ -n "$kv" ] || continue
    k="${kv%%=*}"
    [ -n "${!k+x}" ] || export "$k=${kv#*=}"
done <<<"$ctx_env"

# --- tmux pane marker (consumed by tmux-home): @agent and @agent_model -------
agent=$(ctx_get "$ctx" '.agent // "claude"')
[ -n "$agent" ] || agent=claude
# A tier alias (opus|sonnet|haiku|fable, optionally with [1m]) is resolved through
# the context's own settings.json env (ANTHROPIC_DEFAULT_<TIER>_MODEL); absent key,
# unreadable file or no jq all fall back to publishing the model as given.
marker_model="$model"
tier="${model%\[1m\]}"
case "$tier" in
    opus|sonnet|haiku|fable)
        resolved=$(jq -r --arg k "ANTHROPIC_DEFAULT_$(printf '%s' "$tier" | tr '[:lower:]' '[:upper:]')_MODEL" \
            '.env[$k] // empty' "$config_dir/settings.json" 2>/dev/null) || resolved=""
        [ -z "$resolved" ] || marker_model="$resolved" ;;
esac
mark_pane() { # mark_pane [--dry-run]: never fails, never blocks the launch
    [ -n "${TMUX_PANE:-}" ] || return 0
    if [ "${1:-}" = "--dry-run" ]; then
        printf 'tmux set-option -p -t %s @agent %s\n' "$TMUX_PANE" "$agent"
        if [ -n "$marker_model" ]; then printf 'tmux set-option -p -t %s @agent_model %s\n' "$TMUX_PANE" "$marker_model"
        else printf 'tmux set-option -pu -t %s @agent_model\n' "$TMUX_PANE"; fi
        return 0
    fi
    tmux set-option -p -t "$TMUX_PANE" @agent "$agent" 2>/dev/null || true
    if [ -n "$marker_model" ]; then tmux set-option -p -t "$TMUX_PANE" @agent_model "$marker_model" 2>/dev/null || true
    else tmux set-option -pu -t "$TMUX_PANE" @agent_model 2>/dev/null || true; fi
}

if [ "$dry" -eq 1 ]; then
    printf 'mode: %s\n'       "$mode"
    printf 'context: %s\n'    "$ctx"
    printf 'config_dir: %s\n' "$config_dir"
    printf 'cwd: %s\n'        "$cwd"
    printf 'model: %s\n'      "$model"
    printf 'effort: %s\n'     "$effort"
    if [ "$mode" = resume ]; then
        printf 'resume: %s\n' "$resume"
        printf 'session_id: %s\n' "$resume"
        printf 'resume_group: %s\n' "$(ctx_get "$ctx" '(.resume_group // "none")')"
        printf 'body_bytes: %s (fixed relaunch note, not the file body)\n' "$(printf '%s' "$body" | wc -c | tr -d ' ')"
    else
        printf 'body_bytes: %s\n' "$(printf '%s' "$body" | wc -c | tr -d ' ')"
    fi
    printf 'claude: %s\n'     "$claude_bin"
    printf 'secret_cache_ttl_seconds: %s\n' "${EXXO_SECRET_CACHE_TTL_SECONDS:-unset}"
    printf 'harness: %s\n'       "$harness"
    printf 'account: %s\n'       "$ctx_account"
    printf 'role: %s\n'          "$role"
    printf 'lifetime: %s\n'      "$lifetime"
    printf 'needs: %s\n'         "${needs_raw:-none}"
    printf 'capabilities: %s\n'  "${capabilities_raw:-none}"
    provides_out=$(printf '%s' "${ctx_provides% }" | tr ' ' ',')
    printf 'provides: %s\n'      "${provides_out:-none}"
    printf 'env_pass: %s\n'      "${env_pass_raw:-none}"
    printf 'before_launch: %s\n' "${before_launch_raw:-none}"
    printf 'add_dirs: %s\n'      "${add_dirs[*]:-none}"
    printf 'deny: %s\n'          "${deny_raw:-none}"
    printf 'trust: %s\n'         "$trust_line"
    mark_pane --dry-run
    exit 0
fi

cd "$cwd" || die 5 "cannot enter cwd '$cwd'"
export CLAUDE_CONFIG_DIR="$config_dir"
if [ "$(ctx_get "$ctx" '.openrouter // false')" != true ]; then
    # shellcheck disable=SC2086
    unset $OPENROUTER_ENV
fi
mark_pane
if [ "$mode" = resume ]; then
    exec "$claude_bin" "${add_dir_args[@]+"${add_dir_args[@]}"}" "${deny_args[@]+"${deny_args[@]}"}" --resume "$resume" --model "$model" --effort "$effort" "$body"
fi
# --add-dir is variadic in claude, so its flags go first: the next option ends the
# list and the body stays a lone positional.
exec "$claude_bin" "${add_dir_args[@]+"${add_dir_args[@]}"}" "${deny_args[@]+"${deny_args[@]}"}" --model "$model" --effort "$effort" "$body"
