#!/bin/bash
# Render ~/.gitconfig.local: the machine-local half of the git config.
#
# src/.gitconfig (stowed to ~/.gitconfig) is the shared baseline and carries the
# macOS op-ssh-sign path as its default. Everything that differs per machine
# lives here instead, in a file src/.gitconfig includes last so it wins:
#
#   gpg.ssh.program   1Password's signer, a different binary on every platform
#
# Supersedes the ~/.gpg.gitconfig that older inits wrote. That file is NOT
# included by src/.gitconfig, so on a migrated machine it is dead weight and
# this script removes it.
#
# Windows (Git Bash/MSYS) is a special case: stow cannot symlink there (MSYS
# copies instead unless winsymlinks:nativestrict is set), so there is no stowed
# ~/.gitconfig and no ~/.config/git. This script writes a real ~/.gitconfig that
# *includes* the repo's src/.gitconfig by path, and points allowedSignersFile
# and hooksPath into the repo too.
#
# Idempotent; re-run from init or by hand. Never touches ~/.gitconfig.private,
# which is yours for per-repo includeIf, core.sshCommand and the like.
#
# Usage: scripts/git-config-local [--print]
set -uo pipefail

# Emitted paths must point at the PRIMARY checkout, not whatever worktree ran
# this - a worktree gets removed and would take signing and hooks with it.
repo_root="${HOME}/dev/dotfiles"
[ -d "$repo_root" ] || repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
target="${HOME}/.gitconfig.local"

# GIT_CONFIG_LOCAL_PLATFORM overrides detection (tests only).
case "${GIT_CONFIG_LOCAL_PLATFORM:+override}" in
    override) platform="$GIT_CONFIG_LOCAL_PLATFORM" ;;
    *) case "$(uname -s)" in
    Darwin) platform=mac ;;
    MINGW*|MSYS*|CYGWIN*) platform=windows ;;
    *) if grep -qi microsoft /proc/version 2>/dev/null; then platform=wsl; else platform=linux; fi ;;
    esac ;;
esac

case "$platform" in
    mac)     op_sign="/Applications/1Password.app/Contents/MacOS/op-ssh-sign" ;;
    wsl)     win_user="${WSL_WINDOWS_USER:-$USER}"; win_c="${WSL_WIN_C:-/mnt/c}"
             op_sign="$win_c/Users/$win_user/AppData/Local/Microsoft/WindowsApps/op-ssh-sign-wsl.exe" ;;
    windows) op_sign="$(cygpath -m "${LOCALAPPDATA}/Microsoft/WindowsApps/op-ssh-sign.exe" 2>/dev/null)" ;;
    linux)   op_sign="/opt/1Password/op-ssh-sign" ;;
esac

[ -e "$op_sign" ] || echo "git-config-local: WARNING: no op-ssh-sign at $op_sign - signing will fail" >&2

content="# Generated by scripts/git-config-local - do not edit.
# Hand-written machine-local config belongs in ~/.gitconfig.private instead.
# platform: $platform
[gpg \"ssh\"]
\tprogram = $op_sign"

if [ "$platform" = wsl ]; then
    # git verifies with gpg.ssh.program too, and on WSL that is a WINDOWS binary
    # which cannot read Linux paths - handed /home/... it reports the allowed
    # signers file missing and every signature comes back U. Point it at the
    # Windows-side checkout, the one path both sides can resolve. Omitted when
    # that checkout is absent: signing still works, verification stays U.
    win_signers="$win_c/Users/$win_user/dev/dotfiles/src/.config/git/allowed_signers"
    if [ -r "$win_signers" ]; then
        content="$content
	allowedSignersFile = C:/Users/$win_user/dev/dotfiles/src/.config/git/allowed_signers"
    else
        echo "git-config-local: no Windows-side checkout at $win_signers - leaving allowedSignersFile to the baseline (verification will read U)" >&2
    fi
fi

if [ "$platform" = windows ]; then
    # No stow on Windows, so these cannot be reached at ~/.config/git/.
    content="$content
\tallowedSignersFile = $(cygpath -m "$repo_root")/src/.config/git/allowed_signers
[core]
\thooksPath = $(cygpath -m "$repo_root")/src/.config/git/hooks"
fi

if [ "${1:-}" = --print ]; then printf '%b\n' "$content"; exit 0; fi

if [ -e "$target" ] && [ "$(cat "$target")" = "$(printf '%b' "$content")" ]; then
    echo "git-config-local: ~/.gitconfig.local already current ($platform)"
else
    [ -e "$target" ] && cp "$target" "$target.bak-$(date +%Y%m%d%H%M%S)"
    printf '%b\n' "$content" > "$target"
    echo "git-config-local: wrote ~/.gitconfig.local ($platform)"
fi

# Windows has no stowed ~/.gitconfig; point a real one at the repo baseline.
if [ "$platform" = windows ] && [ ! -L "${HOME}/.gitconfig" ]; then
    win_root="$(cygpath -m "$repo_root")"
    gc="# Generated by scripts/git-config-local - do not edit.
# Windows has no stow, so the shared baseline is included by path instead of
# symlinked, followed by the machine-local layers. They are repeated here
# deliberately: this file must work even when the checkout at $win_root is an
# older revision whose src/.gitconfig predates those includes. Including the
# same file twice is harmless - identical values, last one wins.
[include]
	path = $win_root/src/.gitconfig
[include]
	path = ~/.gitconfig.local
[include]
	path = ~/.gitconfig.private"
    if [ -e "${HOME}/.gitconfig" ] && [ "$(cat "${HOME}/.gitconfig")" = "$(printf '%b' "$gc")" ]; then
        echo "git-config-local: ~/.gitconfig already points at the repo baseline"
    else
        [ -e "${HOME}/.gitconfig" ] && cp "${HOME}/.gitconfig" "${HOME}/.gitconfig.bak-$(date +%Y%m%d%H%M%S)"
        printf '%b\n' "$gc" > "${HOME}/.gitconfig"
        echo "git-config-local: wrote ~/.gitconfig (includes the repo baseline)"
    fi
fi

# The pre-migration file src/.gitconfig never includes: remove it so it cannot
# mislead. Its settings now come from the baseline plus this script's output.
if [ -e "${HOME}/.gpg.gitconfig" ]; then
    mv "${HOME}/.gpg.gitconfig" "${HOME}/.gpg.gitconfig.superseded-$(date +%Y%m%d%H%M%S)"
    echo "git-config-local: retired ~/.gpg.gitconfig (superseded, renamed)"
fi
