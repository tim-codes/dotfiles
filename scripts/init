#!/bin/bash

local_root="${HOME}/.config/local.sh"
local_fish="${HOME}/.config/fish/local.fish"
dotfiles_root="${HOME}/dev/dotfiles"

platform="linux"
if [[ "$(uname)" == "Darwin" ]]; then
  platform="mac"
fi

# create root config file (used by all shells)
mkdir -p $HOME/.config
if [ ! -e "$local_root" ]; then
  touch "$local_root"
  cat <<EOT > "$local_root"
#!/bin/bash

# Compatibility Notes:
# * Both Bash and Fish can read environment variables exported in the format export VAR="value".
# * Variable Names: Ensure variable names are valid in both shells (alphanumeric and underscores).
# * Quotes: Use double quotes for strings to handle spaces and special characters.
# * Arrays: Bash arrays are not directly compatible with Fish arrays. You need to handle them separately.

export DOTFILES_ROOT="$dotfiles_root"
export DOTFILES_PLATFORM="$platform"

export GO_VERSION="1.23.5"
export GOROOT="${HOME}/sdk/go$GO_VERSION"
export GOPATH="${HOME}/.go"

export NODE_VERSION="lts/krypton"
export NVM_DIR="${HOME}/.nvm"
export PNPM_HOME="${HOME}/Library/pnpm"

export STRAY_ROOT="${HOME}/dev"
EOT
fi

# create local fish config
if [ ! -e "$local_fish" ]; then
  mkdir -p "$(dirname "$local_fish")"
  touch "$local_fish"
fi

# create local alacritty config with this machine's fish path (the
# hardcoded /opt/homebrew path crashed alacritty on Linux at launch)
local_alacritty="${HOME}/.config/alacritty/local.toml"
if [ ! -e "$local_alacritty" ] && command -v fish >/dev/null; then
  mkdir -p "$(dirname "$local_alacritty")"
  cat <<EOT > "$local_alacritty"
# Machine-local alacritty overrides (generated by scripts/init - not in git)
[terminal]
shell = "$(command -v fish)"
EOT
fi

# althemer resolves its own config.json via dirs::config_dir(), which on mac
# is Application Support rather than the stowed ~/.config/althemer - symlink it
# so the stowed config is what actually gets read
if [[ "$platform" == "mac" ]]; then
  mkdir -p "${HOME}/Library/Application Support/althemer"
  ln -sf "${HOME}/.config/althemer/config.json" \
    "${HOME}/Library/Application Support/althemer/config.json"
fi

# seed the active-theme indirection file (imported by alacritty.toml, ignored
# while missing). althemer (pointed here via alacritty_config in its
# config.json) rewrites it on every theme switch, so it stays machine-local
# rather than in git.
theme_toml="${HOME}/.config/alacritty/theme.toml"
if [ ! -e "$theme_toml" ]; then
  mkdir -p "$(dirname "$theme_toml")"
  cat <<EOT > "$theme_toml"
[general]
import = ["${HOME}/.config/alacritty/themes/material_prism.toml"]
EOT
fi

# ghostty's equivalent indirection. The include in ghostty's config is marked
# optional (?), so a missing file is not fatal - this just means a fresh
# machine starts on the same theme as alacritty rather than ghostty's default.
# The `theme` fish function rewrites both files together from then on.
ghostty_theme="${HOME}/.config/ghostty/theme.conf"
if [ ! -e "$ghostty_theme" ]; then
  mkdir -p "$(dirname "$ghostty_theme")"
  echo "config-file = themes/material_prism" > "$ghostty_theme"
fi

# and tmux's. Sourced with -q from .tmux.conf above the tpm line, so a missing
# file is silent and catppuccin just renders its own mocha palette instead.
tmux_theme="${HOME}/.config/tmux/theme.conf"
if [ ! -e "$tmux_theme" ]; then
  mkdir -p "$(dirname "$tmux_theme")"
  echo "source-file ~/.config/tmux/themes/material_prism.conf" > "$tmux_theme"
fi

# create default gitconfig file
if [ ! -e "${HOME}/.gpg.gitconfig" ]; then
  if [[ "$platform" == "mac" ]]; then
    op_sign="/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
  elif grep -qi microsoft /proc/version 2>/dev/null; then
    op_sign="/mnt/c/Users/tim/AppData/Local/Microsoft/WindowsApps/op-ssh-sign-wsl.exe"
  else
    op_sign="/opt/1Password/op-ssh-sign"
  fi
  cat <<EOT > ~/.gpg.gitconfig
[gpg]
  format = ssh
[gpg "ssh"]
  program = "$op_sign"
[commit]
  gpgsign = true
[tag]
  gpgSign = true
[user]
  signingkey = todo
EOT
fi

# platform-specific setup (generally just install deps)
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ $platform == "mac" ]; then zsh -i -c "$script_dir/setup-macbook"; fi
if [ $platform == "linux" ]; then "$script_dir/setup-linux"; fi
