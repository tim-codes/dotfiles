#!/bin/bash

local_root="${HOME}/.config/local.sh"
local_fish="${HOME}/.config/fish/local.fish"
dotfiles_root="${HOME}/dev/dotfiles"

# 1Password SSH agent + GitHub SSH auth, before anything else: every clone
# below (and in setup-macbook/cargo-update) is SSH-only
"$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/ssh-prereq" || exit 1

platform="linux"
if [[ "$(uname)" == "Darwin" ]]; then
  platform="mac"
fi

# create root config file (used by all shells)
mkdir -p $HOME/.config
if [ ! -e "$local_root" ]; then
  touch "$local_root"
  cat <<EOT > "$local_root"
#!/bin/bash

# Compatibility Notes:
# * Both Bash and Fish can read environment variables exported in the format export VAR="value".
# * Variable Names: Ensure variable names are valid in both shells (alphanumeric and underscores).
# * Quotes: Use double quotes for strings to handle spaces and special characters.
# * Arrays: Bash arrays are not directly compatible with Fish arrays. You need to handle them separately.

export DOTFILES_ROOT="$dotfiles_root"
export DOTFILES_PLATFORM="$platform"

export GO_VERSION="1.23.5"
export GOROOT="${HOME}/sdk/go$GO_VERSION"
export GOPATH="${HOME}/.go"

export NODE_VERSION="lts/krypton"
export NVM_DIR="${HOME}/.nvm"
export PNPM_HOME="${HOME}/Library/pnpm"

export STRAY_ROOT="${HOME}/dev"
EOT
fi

# create local fish config
if [ ! -e "$local_fish" ]; then
  mkdir -p "$(dirname "$local_fish")"
  touch "$local_fish"
fi

# Generated machine-local files are re-rendered on EVERY run and written only
# when the content changed, so a machine set up before a generator changed
# converges on the next run instead of keeping the old output forever (a
# create-once guard is exactly what left an old local.toml without the tmux
# launch). A differing file is backed up to <file>.bak-<timestamp> first, in
# case it carried hand edits worth promoting into this script. Pass
# --no-backup for pure switcher state (the theme files) that holds no edits.
write_generated() {
  local path="$1" content="$2" backup="${3:-}"
  mkdir -p "$(dirname "$path")"
  if [ -e "$path" ]; then
    [ "$(cat "$path")" = "$content" ] && return 0
    if [ "$backup" != "--no-backup" ]; then
      cp "$path" "$path.bak-$(date +%Y%m%d%H%M%S)"
      echo "init: updated $path (previous version backed up)"
    else
      echo "init: updated $path"
    fi
  fi
  printf '%s\n' "$content" > "$path"
}

# local alacritty config with this machine's fish path (the
# hardcoded /opt/homebrew path crashed alacritty on Linux at launch)
if command -v fish >/dev/null; then
  # Launch straight into tmux where it exists, falling back to a plain fish
  # shell where it does not. Session "main", deliberately NOT the "scratch"
  # session the ghostty dropdown uses: two clients on one session make tmux
  # size its windows to whichever client was used last, so the half-height
  # dropdown would reflow this window every time it opened. -A attaches if it
  # exists and creates it otherwise; tmux's own default-shell is fish, so fish
  # is still the shell inside.
  if command -v tmux >/dev/null; then
    alacritty_shell="shell = { program = \"$(command -v tmux)\", args = [\"new-session\", \"-A\", \"-s\", \"main\"] }"
  else
    alacritty_shell="shell = \"$(command -v fish)\""
  fi
  alacritty_local="# Machine-local alacritty overrides (generated by scripts/init - not in git)

[terminal]
$alacritty_shell"

  # Full screen on the laptop. Native fullscreen rather than SimpleFullscreen,
  # so the window gets its own Space. Mac-only: on linux the window manager
  # owns this.
  if [[ "$platform" == "mac" ]]; then
    alacritty_local="$alacritty_local

[window]
startup_mode = \"Fullscreen\""
  fi
  write_generated "${HOME}/.config/alacritty/local.toml" "$alacritty_local"
fi

# ghostty launches `command` through `login -fl ... bash --noprofile --norc`,
# which reads no profile, so PATH is the bare system default and a bare `tmux`
# is not found. Resolve it here, the same way local.toml resolves fish for
# alacritty, rather than hardcoding a homebrew prefix in the tracked config.
if command -v tmux >/dev/null; then
  write_generated "${HOME}/.config/ghostty/local.conf" "# Machine-local ghostty overrides (generated by scripts/init - not in git)
command = $(command -v tmux) new-session -A -s scratch"
fi

# althemer resolves its own config.json via dirs::config_dir(), which on mac
# is Application Support rather than the stowed ~/.config/althemer - symlink it
# so the stowed config is what actually gets read
if [[ "$platform" == "mac" ]]; then
  mkdir -p "${HOME}/Library/Application Support/althemer"
  ln -sf "${HOME}/.config/althemer/config.json" \
    "${HOME}/Library/Application Support/althemer/config.json"
fi

# Active-theme indirection files: alacritty/theme.toml (imported by
# alacritty.toml), ghostty/theme.conf and tmux/theme.conf (both optional
# includes, so a missing file just means that terminal's default theme).
# althemer and the `theme` fish function rewrite them on every switch, so they
# stay machine-local rather than in git. alacritty's is the source of truth:
# seed it on a fresh machine, then converge ghostty and tmux on whatever theme
# it names - a fixed seed would put a machine that had already switched
# themes on a different theme in each terminal.
theme_toml="${HOME}/.config/alacritty/theme.toml"
if [ ! -e "$theme_toml" ]; then
  write_generated "$theme_toml" "[general]
import = [\"${HOME}/.config/alacritty/themes/material_prism.toml\"]"
fi
theme_name="$(sed -nE 's|.*themes/([^/"]+)\.toml.*|\1|p' "$theme_toml" | head -1)"
if [ -n "$theme_name" ]; then
  # ghostty/tmux themes are generated from alacritty's by
  # scripts/gen-terminal-themes; skip rather than point at a missing file
  if [ -e "${dotfiles_root}/src/.config/ghostty/themes/$theme_name" ]; then
    write_generated "${HOME}/.config/ghostty/theme.conf" "config-file = themes/$theme_name" --no-backup
  else
    echo "init: no ghostty theme for '$theme_name' - run scripts/gen-terminal-themes" >&2
  fi
  if [ -e "${dotfiles_root}/src/.config/tmux/themes/$theme_name.conf" ]; then
    write_generated "${HOME}/.config/tmux/theme.conf" "source-file ~/.config/tmux/themes/$theme_name.conf" --no-backup
  else
    echo "init: no tmux theme for '$theme_name' - run scripts/gen-terminal-themes" >&2
  fi
fi

# create default gitconfig file
if [ ! -e "${HOME}/.gpg.gitconfig" ]; then
  if [[ "$platform" == "mac" ]]; then
    op_sign="/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
  elif grep -qi microsoft /proc/version 2>/dev/null; then
    op_sign="/mnt/c/Users/tim/AppData/Local/Microsoft/WindowsApps/op-ssh-sign-wsl.exe"
  else
    op_sign="/opt/1Password/op-ssh-sign"
  fi
  cat <<EOT > ~/.gpg.gitconfig
[gpg]
  format = ssh
[gpg "ssh"]
  program = "$op_sign"
[commit]
  gpgsign = true
[tag]
  gpgSign = true
[user]
  signingkey = todo
EOT
fi

# platform-specific setup (generally just install deps)
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ $platform == "mac" ]; then zsh -i -c "$script_dir/setup-macbook"; fi
if [ $platform == "linux" ]; then "$script_dir/setup-linux"; fi

# worktrunk shell integration: `wt switch` has to cd the parent shell, which
# takes a shell function. The installer writes a lazy stub (sources the full
# integration on first use, so no startup cost) into fish's functions/ and
# completions/ - fisher-managed dirs, not stowed. Re-run every time so the
# stub tracks the installed worktrunk version. fish only: zsh and bash are
# variables-and-PATH fallbacks here.
if command -v wt >/dev/null; then
  wt config shell install fish --yes >/dev/null
fi

# Claude Code contexts and their repo-managed config (settings, CLAUDE.md, MCP
# servers, skills). Both are idempotent; claude-sync needs jq, which the
# platform setup above installs.
"$script_dir/claude-contexts"
if command -v jq >/dev/null; then
  "$script_dir/claude-sync"
else
  echo "init: jq not installed - skipped scripts/claude-sync" >&2
fi
