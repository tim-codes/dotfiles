.idea
.vscode
.DS_Store
src/bin/*
!src/bin/deps-up
!src/bin/pop-term
!src/bin/firefox-tab-watchdog
!src/bin/tmux-pane-host
!src/bin/tmux-client-detach-hint
!src/bin/tmux-short-path
!src/bin/ghostty-fit
!src/bin/worktree-relocate-transcripts
!src/bin/worktree-copy-local-env
!src/bin/worktree-closedown
!src/bin/squad-tunnel
!src/bin/claude-kickoff
!src/bin/ux-designer-peer
!src/bin/testlock
!src/bin/review-ci
.claude
src/.config/alacritty/local.toml
src/.config/alacritty/theme.toml
src/.config/ghostty/theme.conf
src/.config/ghostty/local.conf
# scripts/init backs up a generated file it replaces; ~/.config/<app> is a
# stow-folded link into src/, so the backups land here
src/.config/alacritty/local.toml.bak-*
src/.config/ghostty/local.conf.bak-*
src/.config/tmux/theme.conf
src/.config/tmux/theme-scratch.conf
# Claude Code per-account cache of claude.ai account skills, written through
# the ~/.claude-personal/skills whole-dir symlink (see scripts/claude-sync).
files/claude/skills/synced/
__pycache__/
*.pyc
src/.config/squad/tunnel.json

# squad: key-like material must never be committed from the stowed config dir (the repo is public).
# Tracked files are re-included explicitly; keys live under ~/.local/state/squad/keys.
src/.config/squad/*.json
!src/.config/squad/member-settings.json
!src/.config/squad/tunnel.json
src/.config/squad/*.key
src/.config/squad/*.pem
src/.config/squad/agent.env
src/.config/squad/*.bak*
