{
  "env": {
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1"
  },
  "model": "opus",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v squad >/dev/null 2>&1 && o=$(squad hook prompt-cleared) && printf '%s\\n' \"$o\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v squad >/dev/null 2>&1 && o=$(squad hook prompt-cleared) && printf '%s\\n' \"$o\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dev/dotfiles/files/claude/hooks/guard-dotfiles-checkout.sh\" # dotfiles-guard-primary-checkout"
          }
        ]
      },
      {
        "matcher": "ExitWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dev/dotfiles/files/claude/hooks/preserve-worktree-transcripts.sh\" # worktree-transcript-preserve"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dev/dotfiles/scripts/claude-agent-model-guard\" # claude-agent-model-guard"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v squad >/dev/null 2>&1 && o=$(squad hook pre-tool-use) && printf '%s\\n' \"$o\"; exit 0",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "command -v squad >/dev/null 2>&1 && o=$(squad hook pre-tool-use) && printf '%s\\n' \"$o\"; exit 0",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v squad >/dev/null 2>&1 && o=$(squad hook permission) && [ -n \"$o\" ] && printf '%s\\n' \"$o\"; exit 0",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v squad >/dev/null 2>&1 && o=$(squad hook permission) && [ -n \"$o\" ] && printf '%s\\n' \"$o\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dev/dotfiles/files/claude/hooks/preserve-worktree-transcripts.sh\" # worktree-transcript-preserve"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v squad >/dev/null 2>&1 && o=$(squad hook session-end) && printf '%s\\n' \"$o\"; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v squad >/dev/null 2>&1 && o=$(squad hook session-start) && printf '%s\\n' \"$o\"; exit 0",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dev/dotfiles/scripts/claude-scratch-persist\" start # claude-scratch-persist",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v squad >/dev/null 2>&1 && o=$(squad hook stop) && printf '%s\\n' \"$o\"; exit 0",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dev/dotfiles/scripts/claude-scratch-persist\" stop # claude-scratch-persist",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v squad >/dev/null 2>&1 && o=$(squad hook user-prompt-submit) && printf '%s\\n' \"$o\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v squad >/dev/null 2>&1 && o=$(squad hook stop) && printf '%s\\n' \"$o\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v squad >/dev/null 2>&1 && o=$(squad hook prompt-cleared) && printf '%s\\n' \"$o\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v squad >/dev/null 2>&1 && o=$(squad hook subagent-start) && printf '%s\\n' \"$o\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v squad >/dev/null 2>&1 && o=$(squad hook subagent-stop) && printf '%s\\n' \"$o\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v squad >/dev/null 2>&1 && o=$(squad hook permission-request) && printf '%s\\n' \"$o\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": false,
  "enabledPlugins": {
    "vercel@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "shell-lsp@dotfiles": true,
    "notion@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "worktrunk@worktrunk": true,
    "exxo-common@exxo-skills": true,
    "exxo-mantine@exxo-skills": true
  },
  "extraKnownMarketplaces": {
    "dotfiles": {
      "source": {
        "source": "directory",
        "path": "/Users/tim/dev/dotfiles/files/claude/plugins"
      }
    },
    "worktrunk": {
      "source": {
        "source": "git",
        "url": "git@github.com:max-sixty/worktrunk.git"
      }
    },
    "exxo-skills": {
      "source": {
        "source": "git",
        "url": "git@github.com:Exxo-Labs/skills.git"
      },
      "autoUpdate": true
    }
  },
  "crossSessionInbound": "accept",
  "dialogExpiry": "10m",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git worktree list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(just --list:*)",
      "Bash(squad doctor:*)",
      "Bash(squad debug report:*)",
      "Bash(worktree-closedown:*)",
      "mcp__squad__register",
      "mcp__squad__set",
      "mcp__squad__ack",
      "mcp__squad__delegate",
      "mcp__squad__delegate_result",
      "mcp__squad__job_review",
      "mcp__squad__raise",
      "mcp__squad__watch",
      "mcp__squad__unwatch",
      "mcp__squad__heavy_slot",
      "mcp__squad__land",
      "WebSearch",
      "mcp__plugin_linear_linear__save_comment",
      "mcp__plugin_linear_linear__save_issue",
      "mcp__plugin_linear_linear__save_issue_label",
      "mcp__claude_ai_Linear__save_comment",
      "mcp__claude_ai_Linear__save_issue",
      "mcp__squad__claim",
      "mcp__squad__intervene",
      "mcp__ide__getDiagnostics",
      "Bash(gsutil ls:*)",
      "Bash(pulumi preview:*)",
      "Bash(pulumi whoami:*)",
      "Bash(pulumi stack ls:*)",
      "Bash(pulumi stack output:*)",
      "Bash(agent-tooling gcp-ro:*)",
      "Bash(agent-tooling:*)"
    ],
    "ask": [
      "Bash(agent-tooling mail send*)",
      "Bash(agent/run -- agent-tooling mail send*)",
      "Bash(./agent/run -- agent-tooling mail send*)"
    ],
    "deny": [
      "Bash(op read*)",
      "Bash(* op read*)",
      "Bash(*--reveal*)",
      "Bash(*--show-secrets*)",
      "Bash(pulumi env open*)",
      "Bash(* pulumi env open*)",
      "Bash(esc env open*)",
      "Bash(* esc env open*)",
      "Bash(gcloud secrets versions access*)",
      "Bash(* gcloud secrets versions access*)",
      "Read(**/.claude.json)",
      "Read(**/.credentials.json)",
      "Bash(gcloud compute ssh*)",
      "Bash(* gcloud compute ssh*)"
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
