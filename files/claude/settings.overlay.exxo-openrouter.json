{
  "env": {
    "ANTHROPIC_BASE_URL": "https://openrouter.ai/api",
    "ANTHROPIC_API_KEY": "",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "moonshotai/kimi-k3@preset/tim-k3",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "moonshotai/kimi-k3@preset/tim-k3",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "moonshotai/kimi-k3@preset/tim-k3",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "moonshotai/kimi-k3@preset/tim-k3",
    "CLAUDE_CODE_SUBAGENT_MODEL": "moonshotai/kimi-k3@preset/tim-k3",
    "ENABLE_TOOL_SEARCH": "false"
  },
  "apiKeyHelper": "$HOME/dev/dotfiles/scripts/claude-openrouter-key",
  "model": "sonnet",
  "deniedMcpServers": [
    { "serverName": "datadog" },
    { "serverName": "boards" }
  ],
  "permissions": {
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(* gh pr merge*)",
      "Bash(*gh api*/merge*)",
      "Bash(git push*main*)",
      "Bash(* git push*main*)",
      "Bash(git push*master*)",
      "Bash(* git push*master*)",
      "Bash(*agent/run*)",
      "Bash(*agent-run*)",
      "Bash(squad mail:*)",
      "Bash(esc)",
      "Bash(esc *)",
      "Bash(* esc *)",
      "Bash(pulumi up*)",
      "Bash(* pulumi up*)",
      "Bash(pulumi env open*)",
      "Bash(* pulumi env open*)",
      "Bash(op)",
      "Bash(op *)",
      "Bash(* op *)",
      "Read(~/keys/**)",
      "Bash(cat *~/keys*)",
      "Bash(* cat *~/keys*)",
      "Bash(cat *$HOME/keys*)",
      "Bash(* cat *$HOME/keys*)",
      "Bash(cat */Users/*/keys*)",
      "Bash(* cat */Users/*/keys*)",
      "Bash(head *~/keys*)",
      "Bash(* head *~/keys*)",
      "Bash(head *$HOME/keys*)",
      "Bash(* head *$HOME/keys*)",
      "Bash(head */Users/*/keys*)",
      "Bash(* head */Users/*/keys*)",
      "Bash(less *~/keys*)",
      "Bash(* less *~/keys*)",
      "Bash(less *$HOME/keys*)",
      "Bash(* less *$HOME/keys*)",
      "Bash(less */Users/*/keys*)",
      "Bash(* less */Users/*/keys*)",
      "Bash(grep *~/keys*)",
      "Bash(* grep *~/keys*)",
      "Bash(grep *$HOME/keys*)",
      "Bash(* grep *$HOME/keys*)",
      "Bash(grep */Users/*/keys*)",
      "Bash(* grep */Users/*/keys*)",
      "Bash(cp *~/keys*)",
      "Bash(* cp *~/keys*)",
      "Bash(cp *$HOME/keys*)",
      "Bash(* cp *$HOME/keys*)",
      "Bash(cp */Users/*/keys*)",
      "Bash(* cp */Users/*/keys*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dev/dotfiles/scripts/claude-openrouter-guard\"; rc=$?; case $rc in 126|127) printf '%s\\n' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"claude-openrouter-guard could not start (python3 missing?); failing closed\"}}'; exit 0;; esac; exit $rc # claude-openrouter-guard"
          }
        ]
      }
    ]
  }
}
