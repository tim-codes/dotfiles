{
  "enabledPlugins": {
    "exxo-common@exxo-skills": true,
    "exxo-mantine@exxo-skills": true
  },
  "extraKnownMarketplaces": {
    "exxo-skills": {
      "source": {
        "source": "git",
        "url": "git@github.com:Exxo-Labs/skills.git"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(gcloud * list:*)",
      "Bash(gcloud * describe:*)",
      "Bash(pulumi preview:*)",
      "Bash(pulumi whoami:*)",
      "Bash(pulumi stack ls:*)",
      "Bash(pulumi stack output:*)",
      "Bash(agent-tooling:*)"
    ]
  }
}
