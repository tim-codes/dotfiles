#!/usr/bin/env bash
# squad-watch-mail-launch — start `squad watch mail` under launchd with a
# 1Password service-account token, so the mail child (agent-run ->
# agent-tooling mail serve) can resolve its GRAPH_MAIL_* references with no
# human and no biometric prompt.
#
# The token lives in the macOS login Keychain as the generic password
# `tim-squad-op-sa` (add it with `security add-generic-password -a "$USER"
# -s tim-squad-op-sa -w`, which prompts for the value). It is read into one
# environment variable (with AGENT_ENV_FILE pointing at
# ~/.config/exxo/unattended.env, which must exist) and handed to `squad` by exec; it is never printed,
# logged or written to a file. When it is missing the wrapper exits 78
# (EX_CONFIG) with one line on stderr, so launchd marks the job failed and
# its ThrottleInterval, not a hot loop, paces the retries.
set -euo pipefail

env_file="$HOME/.config/exxo/unattended.env"
if [ ! -f "$env_file" ]; then
  echo "squad-watch-mail-launch: $env_file is missing (the unattended agent.env); not starting" >&2
  exit 78
fi

token="$(security find-generic-password -s tim-squad-op-sa -w 2>/dev/null || true)"
if [ -z "$token" ]; then
  echo "squad-watch-mail-launch: no Keychain item tim-squad-op-sa (1Password service-account token); not starting" >&2
  exit 78
fi
OP_SERVICE_ACCOUNT_TOKEN="$token"
export OP_SERVICE_ACCOUNT_TOKEN
# agent-run reads its manifest from here instead of the attended agent.env
# files, and strips the token from the child's environment itself.
AGENT_ENV_FILE="$env_file"
export AGENT_ENV_FILE
unset token
exec squad watch mail "$@"
