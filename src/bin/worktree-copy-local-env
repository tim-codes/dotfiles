#!/bin/bash
# Copy the primary checkout's local, gitignored config files (.env, .env.local,
# agent.env, .envrc, *.local.*) into a git worktree, so a fresh worktree is
# runnable without anyone asking the operator to hand-copy them.
#
#   worktree-copy-local-env [-n] <worktree> [<source-checkout>]
#     -n  dry run: list what would be copied, change nothing
#     <source-checkout> defaults to the repo's primary worktree.
#
# Wired as worktrunk's user-level pre-start hook (src/.config/worktrunk/
# config.toml), so it runs once whenever `wt switch --create` makes a worktree
# - pre-start rather than post-start because it blocks, so the files exist
# before any project post-start hook (dev server, install) wants them. Run it by
# hand for a worktree made without wt (`git worktree add`, EnterWorktree, an
# isolation: "worktree" agent) - safe to repeat.
#
# Looks at the whole tree, at any depth (deploy/.env, gui/.env.local, ...). The
# candidates come from git itself - the source checkout's ignored, untracked
# files - so nothing is guessed from the filesystem. Only these names qualify:
# .env, .env.*, agent.env, .envrc, *.local.* (so .env.example is only copied
# where the repo gitignores it). A file is copied only when ALL hold:
#   - it is gitignored in the source checkout and not tracked (tracked files
#     arrive with the branch anyway); git does not descend into nested git
#     checkouts, and paths under node_modules, .git, target, dist, build,
#     .next, vendor and .venv are skipped;
#   - it is a regular file, not a symlink, and no directory above it is a
#     symlink (symlinks are typically recreated by the repo's own install step,
#     and would dangle or alias the source);
#   - the destination does not already exist (never overwrites). Missing parent
#     directories are created, so an untracked deploy/ still gets deploy/.env.
# Names are printed, contents never are. Mode is preserved (.env is often 0600).
#
# FAIL-OPEN on purpose: a pre-start hook that exits non-zero aborts worktree
# creation, and a missing .env is recoverable where a missing worktree is not.
# Problems are warned about on stderr and the exit status stays 0.
set -u

dry=0
if [ "${1:-}" = -n ]; then dry=1; shift; fi
if [ $# -lt 1 ] || [ $# -gt 2 ]; then
    echo "usage: worktree-copy-local-env [-n] <worktree> [<source-checkout>]" >&2
    exit 2
fi

warn() { echo "worktree-copy-local-env: warning: $*" >&2; }

dest="$(git -C "$1" rev-parse --show-toplevel 2>/dev/null)" || { warn "not a git worktree: $1"; exit 0; }
if [ $# -eq 2 ]; then
    src="$(git -C "$2" rev-parse --show-toplevel 2>/dev/null)" || { warn "not a git checkout: $2"; exit 0; }
else
    # First entry of `git worktree list` is the primary (main) worktree.
    src="$(git -C "$dest" worktree list --porcelain | sed -n '1s/^worktree //p')"
fi
[ -d "$src" ] || { warn "source checkout not found: ${src:-<empty>}"; exit 0; }
[ "$src" = "$dest" ] && exit 0

# The source's ignored, untracked files, NUL-separated so odd names survive.
# -z also stops git quoting paths. Filtering by name happens below.
while IFS= read -r -d '' rel; do
    case "$rel" in
        node_modules/*|*/node_modules/*|.git/*|*/.git/*|target/*|*/target/*|dist/*|*/dist/*|build/*|*/build/*|.next/*|*/.next/*|vendor/*|*/vendor/*|.venv/*|*/.venv/*) continue ;;
    esac
    base="${rel##*/}"
    case "$base" in
        .env|.env.*|agent.env|.envrc|*.local.*) ;;
        *) continue ;;
    esac
    f="$src/$rel"
    [ -f "$f" ] && [ ! -L "$f" ] || continue
    [ -e "$dest/$rel" ] || [ -L "$dest/$rel" ] && continue
    # No symlinked directory on either side: it could lead out of the checkout.
    d="$(dirname "$rel")"
    if [ "$d" != . ]; then
        [ "$(cd "$src/$d" 2>/dev/null && pwd -P)" = "$(cd "$src" && pwd -P)/$d" ] || continue
        [ "$(cd "$dest/$d" 2>/dev/null && pwd -P)" = "$(cd "$dest" && pwd -P)/$d" ] || [ ! -e "$dest/$d" ] || continue
    fi
    git -C "$src" ls-files --error-unmatch -- "$rel" >/dev/null 2>&1 && continue
    if [ "$dry" -eq 0 ]; then
        mkdir -p "$dest/$d" && cp -p "$f" "$dest/$rel" || { warn "could not copy $rel"; continue; }
        echo "worktree-copy-local-env: copied $rel"
    else
        echo "worktree-copy-local-env: would copy $rel"
    fi
done < <(git -C "$src" ls-files -z --others --ignored --exclude-standard 2>/dev/null | sort -z)

exit 0
