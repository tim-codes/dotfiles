#!/bin/zsh

$DOTFILES_ROOT/scripts/brew-update
$DOTFILES_ROOT/scripts/cargo-update
$DOTFILES_ROOT/scripts/gcloud-setup
$DOTFILES_ROOT/scripts/pwsh-modules
$DOTFILES_ROOT/scripts/pipx-packages

# tmux plugins: converge on .tmux.conf (install new, drop removed), pull
# everything to latest, and rebuild tmux-home against the new source.
$DOTFILES_ROOT/scripts/tmux-plugins --update

# todo (#244): this is only working from native terminal, not emulator
# fish -c "fisher update"

# Node comes from mise, pinned to the 24 major in ~/.config/mise/config.toml
# (src/.config/mise/). `mise install` fetches 24.x if missing; `mise upgrade`
# stays inside the configured range, so it never crosses to a newer major (that
# needs `--bump`, deliberately not used). mise re-points the stable
# ~/.local/share/mise/installs/node/24 symlink on upgrade. --prune drops the
# superseded 24.x builds.
if command -v mise >/dev/null; then
  mise install
  mise upgrade --prune
  mise reshim
fi
# nvm is no longer on PATH, but ~/.nvm/versions/node/v24.21.0 must STAY on disk:
# the squad launchd jobs (~/Library/LaunchAgents/dev.tim.squad-*.plist) name that
# path. Do not uninstall it until those plists move to the mise path.

# install global pnpm packages; ~/.npmrc (private @exxo-labs registry auth)
# must be rendered first
if command -v pnpm >/dev/null; then
  $DOTFILES_ROOT/scripts/npmrc-render
  $DOTFILES_ROOT/scripts/pnpm-globals
fi