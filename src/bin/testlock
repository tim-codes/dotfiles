#!/bin/bash
# testlock: run ONE heavy command (a test run or a build) at a time across every
# session on this machine, and only while the 1-minute load average is under a ceiling.
#
# The machine rule it enforces: one test run or build at a time, host load under N.
# Several agent sessions share one box; unserialised, their suites and builds pile up
# and every one of them times out. Wrap the heavy command, run from the directory it needs:
#
#   testlock pnpm vitest run src/foo.test.ts
#   TESTLOCK_MAX_LOAD=12 testlock just ci
#   testlock --status [--json]    counts only: lock held?, holder label and age, waiters, load
#   testlock --help | -h          usage
#
# --status never takes the lock, waits or runs anything, and never prints a command line
# or environment (the owner file's command field is deliberately not shown): use it, not
# `ps` or `pgrep`, to look at the queue.
#
# The lock is a mkdir'd directory holding an `owner` file (pid, label, time, command).
# Each waiting testlock touches <TESTLOCK_DIR>.waiters/<pid> and removes it on exit; --status
# counts those entries, pruning dead pids with kill -0.
# A lock whose owner pid is dead is reclaimed. While waiting, testlock says what it is
# waiting on. The command runs under timeout(1) (or gtimeout) and its exit code is passed
# through (124 when timeout killed it).
#
# Env:
#   TESTLOCK_MAX_LOAD   load-average ceiling (default 20)
#   TESTLOCK_TIMEOUT_S  kill the command after this many seconds (default 2400)
#   TESTLOCK_LABEL      name shown to waiters (default: basename of $PWD)
#   TESTLOCK_DIR        lock directory (default ${XDG_RUNTIME_DIR:-/tmp}/testlock-$USER.d)
#   TESTLOCK_POLL_S / TESTLOCK_LOAD_POLL_S   seconds between lock / load checks (5 / 20)
# Works under macOS /bin/bash 3.2.
set -u
usage() {
  echo "usage: testlock <command...>" >&2
  echo "       testlock --status [--json]   counts only: lock, holder label and age, waiters, load" >&2
  echo "       testlock --help | -h" >&2
}
case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac
if [ $# -eq 0 ]; then
  usage
  exit 64
fi
want_status=0; json=0
case "$1" in
  --status|status)
    want_status=1
    case "${2:-}" in
      "") ;;
      --json) json=1 ;;
      *) usage; exit 64 ;;
    esac
    [ $# -le 2 ] || { usage; exit 64; }
    ;;
esac
LOCKDIR="${TESTLOCK_DIR:-${XDG_RUNTIME_DIR:-/tmp}/testlock-${USER:-$(id -un)}.d}"
WAITDIR="$LOCKDIR.waiters"
MAX_LOAD="${TESTLOCK_MAX_LOAD:-20}"
TIMEOUT_S="${TESTLOCK_TIMEOUT_S:-2400}"
POLL_S="${TESTLOCK_POLL_S:-5}"
LOAD_POLL_S="${TESTLOCK_LOAD_POLL_S:-20}"
# No whitespace in the label, so the owner file's fields split cleanly.
label="$(printf '%s' "${TESTLOCK_LABEL:-$(basename "$PWD")}" | tr -s '[:space:]' '_')"

tmo=$(command -v timeout || command -v gtimeout || true)

load1() {
  local v
  v=$(sysctl -n vm.loadavg 2>/dev/null | awk '{print int($2)}')
  if [ -z "$v" ] && [ -r /proc/loadavg ]; then v=$(awk '{print int($1)}' /proc/loadavg); fi
  echo "${v:-0}"
}

# iso_epoch <ISO-8601 UTC>: epoch seconds (BSD date, then GNU date), empty if unparsable.
iso_epoch() {
  date -j -u -f '%Y-%m-%dT%H:%M:%SZ' "$1" +%s 2>/dev/null || date -u -d "$1" +%s 2>/dev/null
}

# json_str <s>: s as a JSON string.
json_str() {
  local v=${1//\\/\\\\}
  v=${v//\"/\\\"}
  printf '"%s"' "$v"
}

# status: counts only. Never prints the owner file's command field or any process data.
status() {
  local held=no pid="" olabel="" ots="" age="" n=0 f p holder_pid="" load
  if [ -d "$LOCKDIR" ]; then
    read -r pid olabel ots _ < "$LOCKDIR/owner" 2>/dev/null || true
    holder_pid=$pid
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      held=yes
      local e now
      e=$(iso_epoch "$ots"); now=$(date -u +%s)
      if [ -n "$e" ]; then age=$((now - e)); [ "$age" -ge 0 ] || age=0; fi
    fi
  fi
  if [ -d "$WAITDIR" ]; then
    for f in "$WAITDIR"/*; do
      [ -e "$f" ] || continue
      p=${f##*/}
      case "$p" in *[!0-9]*|"") continue ;; esac
      if kill -0 "$p" 2>/dev/null; then
        [ "$p" = "$holder_pid" ] || n=$((n + 1))
      else
        rm -f "$f"
      fi
    done
  fi
  load=$(load1)
  if [ "$json" -eq 1 ]; then
    printf '{"held":%s' "$([ "$held" = yes ] && echo true || echo false)"
    if [ "$held" = yes ]; then
      printf ',"holder_label":%s,"held_seconds":%s' "$(json_str "$olabel")" "${age:-null}"
    fi
    printf ',"waiters":%s,"load":%s,"max_load":%s}\n' "$n" "$load" "$MAX_LOAD"
  else
    echo "lock held: $held"
    if [ "$held" = yes ]; then
      echo "holder: $olabel${age:+ (held ${age}s)}"
    fi
    echo "waiters: $n"
    echo "load: $load (ceiling $MAX_LOAD)"
  fi
}

if [ "$want_status" -eq 1 ]; then
  status
  exit 0
fi

held_lock=0
# shellcheck disable=SC2329  # invoked via the EXIT trap
cleanup() {
  rm -f "$WAITDIR/$$"
  [ "$held_lock" -eq 1 ] && rm -rf "$LOCKDIR"
  return 0
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
mkdir -p "$WAITDIR" 2>/dev/null && : > "$WAITDIR/$$"

waited=0
while :; do
  if mkdir "$LOCKDIR" 2>/dev/null; then
    echo "$$ $label $(date -u +%FT%TZ) $*" > "$LOCKDIR/owner"
    held_lock=1
    rm -f "$WAITDIR/$$"
    break
  fi
  owner_pid=$(cut -d' ' -f1 "$LOCKDIR/owner" 2>/dev/null)
  if [ -n "${owner_pid:-}" ] && ! kill -0 "$owner_pid" 2>/dev/null; then
    echo "testlock: reclaiming a stale lock (pid $owner_pid is gone)" >&2
    rm -rf "$LOCKDIR"; continue
  fi
  if [ $((waited % 120)) -eq 0 ]; then
    echo "testlock: waiting for the lock held by: $(cat "$LOCKDIR/owner" 2>/dev/null)" >&2
  fi
  sleep "$POLL_S"; waited=$((waited + POLL_S))
done

while :; do
  load=$(load1)
  [ "$load" -lt "$MAX_LOAD" ] && break
  echo "testlock: load $load >= $MAX_LOAD, waiting $LOAD_POLL_S s" >&2; sleep "$LOAD_POLL_S"
done

echo "testlock: running ($label): $*" >&2
if [ -n "$tmo" ]; then
  "$tmo" --signal=TERM --kill-after=30 "$TIMEOUT_S" "$@"
else
  echo "testlock: no timeout/gtimeout on PATH (brew install coreutils); running without a time limit" >&2
  "$@"
fi
rc=$?
echo "testlock: exit $rc ($label)" >&2
exit $rc
