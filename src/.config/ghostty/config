# Ghostty exists here for exactly one job: the dropdown (quick) terminal.
# Alacritty stays the daily driver for full windows. Ghostty is the one of the
# two with a native quick-terminal, and confining it to a scratch overlay keeps
# its known multi-day-uptime port-leak crash away from long-lived agent
# sessions.
#
# theme.conf is the active-theme indirection, the exact mirror of alacritty's
# theme.toml: machine-local, gitignored, rewritten by the `theme` function in
# fish. The `?` prefix marks the include optional - without it a missing file
# is a HARD error, which would break a fresh machine before the first theme
# switch. The path is relative, resolved against the directory of the real file
# (symlinks are followed), i.e. src/.config/ghostty/ in this repo.
#
# Note on ordering: a config-file include is applied AFTER the entire
# containing file regardless of where the directive appears, so the theme
# always wins over anything set below. That is deliberate.
config-file = ?theme.conf

# local.conf carries the per-machine bits, generated by scripts/init and
# gitignored - same split as alacritty's local.toml, and for the same reason:
# the homebrew prefix differs between apple silicon and intel, so it must not
# be hardcoded in a tracked file. It holds the `command` that starts tmux,
# because Ghostty launches it via `login -fl ... /bin/bash --noprofile --norc`,
# which reads no profile at all - so PATH is the bare system default and a
# bare `tmux` is not found.
config-file = ?local.conf

# Match alacritty.toml so the dropdown is visually continuous with the
# full-size windows.
font-family = GeistMono Nerd Font Mono
font-size = 15

# --- quick terminal ---------------------------------------------------------
# position is macOS-restart-only, not reloadable - changing it needs a full
# Ghostty quit, not `theme` or SIGUSR2.
# Centred floating window rather than a pull-down. Width,height for `center` on
# a landscape screen, recomputed per screen on show. This is only the fallback
# for a screen the quick terminal has never been fitted on: Ghostty remembers
# the last frame per display and restores that instead, and `gz`
# (src/bin/ghostty-fit) fits it to screen-minus-gutter capped at 1440 wide -
# which config can't express (no min/max) - once per monitor.
quick-terminal-position = center
quick-terminal-size = 1440px,90%
# No slide: centred, it should just appear, like an iTerm2 hotkey window.
quick-terminal-animation-duration = 0
# Only the hotkey hides it. The default (true) also hides it whenever it loses
# focus, which makes it useless for anything you want to watch while working in
# another window - a running build, a tailed log, an agent mid-task.
quick-terminal-autohide = false
# follow between Spaces rather than yanking focus back to where it was opened
quick-terminal-space-behavior = move

# Visible in the dock and app switcher, on trial. `always` (hidden) is what
# Ghostty suggests for dropdown-only use, but combined with autohide = false it
# stranded the dropdown: Cmd+Tab away and there is no way to Cmd+Tab back, and
# the hotkey's first press then hides the still-open (just unfocused) window,
# so it takes two presses to return. 1.3.1 has no "focus if open" action.
# Showing the app lets Cmd+Tab reach the open dropdown.
macos-hidden = never
# Never create a normal window by itself: none at launch (the quick
# terminal is created on first toggle), none restored after a restart. One
# path can't be configured away - activating the already-running app with no
# windows open (`open -a Ghostty`, Spotlight) makes Ghostty open a new window
# unconditionally (applicationShouldHandleReopen) - so go in through the hotkey.
initial-window = false
window-save-state = never

# `global:` needs Accessibility permission; Ghostty prompts for it on first
# load of a global keybind (System Settings > Privacy & Security >
# Accessibility).
#
# Two triggers for one action. A bare unmodified key is deliberate - this is
# the classic quake-console binding - but note a global bind swallows the key
# everywhere, so § can no longer be typed in any app.
#
# § is written as a literal character, which binds the *translated* key: it
# follows the keyboard layout and simply never fires on a layout that has no
# §, which is exactly the wanted fallback behaviour on ANSI keyboards.
keybind = global:§=toggle_quick_terminal
#
# For keyboards without §. grave_accent is a *physical* key name - the
# top-left position, which is where backtick sits on ANSI layouts. On this
# machine's British/ISO layout that same physical key is §, so here this is
# just Opt+§; it earns its place on ANSI keyboards.
keybind = global:opt+grave_accent=toggle_quick_terminal

# tmux prefix on Cmd+. : tmux can't see Cmd, so send its real prefix, C-a.
# Same binding and reasoning in alacritty.toml (on Linux, super is Super).
keybind = super+period=text:\x01

# --- shell ------------------------------------------------------------------
# `command` lives in local.conf (see above) because it needs tmux's absolute
# path. It starts tmux in its own session, deliberately NOT the one the
# Alacritty window is on: two clients attached to one session make tmux size
# its windows to whichever client was used last, so a half-height dropdown
# would reflow the full-screen window every time it opened. -A attaches if
# `scratch` exists and creates it otherwise, which also means every toggle
# after the first skips shell startup.
#
# It applies to every Ghostty surface, not just the quick terminal - Ghostty
# has no per-surface-type config condition. Harmless while Ghostty is only ever
# the dropdown.
