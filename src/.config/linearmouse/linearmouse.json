{
  "$schema" : "https://schema.linearmouse.app/0.11.4",
  "schemes" : [
    {
      "if" : {
        "device" : {
          "category" : "mouse"
        }
      },
      "buttons" : {
        "universalBackForward" : true
      },
      "scrolling" : {
        "reverse" : {
          "vertical" : true
        },
        "acceleration" : {
          "vertical" : 1
        },
        "distance" : {
          "vertical" : "auto"
        },
        "smoothed" : {
          "vertical" : {
            "acceleration" : 1.08,
            "bouncing" : false,
            "enabled" : true,
            "inertia" : 0.72,
            "preset" : "quadratic",
            "response" : 0.58,
            "speed" : 1.02
          }
        },
        "speed" : {
          "vertical" : 0
        }
      }
    }
  ]
}
