[user]
    name = "Tim O'Connell"
    email = tim@exxo.sh
    ; The "Git" SSH key held in 1Password — used for both auth (1P SSH agent)
    ; and commit/tag signing (op-ssh-sign below). No GPG anywhere.
    signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMw7ZezK984Ovyr3ri/E5GdMaaBGGE5i9UkIuPQx1sG5

[gpg]
    format = ssh
[gpg "ssh"]
    program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
    ; Lets `git log --show-signature` verify our own signatures locally.
    allowedSignersFile = ~/.config/git/allowed_signers
[commit]
    gpgsign = true
[tag]
    gpgsign = true

[alias]
    undo = reset HEAD^
    unstage = reset HEAD --

; submodule.recurse is deliberately NOT set globally — repos opt in via their
; own recommended local gitconfig (see e.g. h2gc-portal's enable/disable
; recipes). The post-checkout hook below warns wherever it isn't handled.
[core]
    ; Global hooks (post-checkout drift warning). NOTE: a global hooksPath
    ; hides per-repo .git/hooks — our hooks chain to them, see the scripts.
    hooksPath = ~/.config/git/hooks

[pull]
    rebase = true
[push]
    autoSetupRemote = true

[url "ssh://git@github.com/"]
    insteadOf = https://github.com/
[url "ssh://git@gitlab.com/"]
    insteadOf = https://gitlab.com/
