# AWS CLI Configuration
# Managed via dotfiles - do not edit directly in ~/.aws/

# ============================================
# SSO Sessions (one per organization)
# ============================================

# [sso-session another-org]
# sso_start_url = https://d-xxxxxxxxxx.awsapps.com/start
# sso_region = us-east-1
# sso_registration_scopes = sso:account:access

# ============================================
# Profiles (multiple per session/org)
# ============================================

# Personal account, console credentials via `aws login --profile tim-personal`
# (browser sign-in; short-lived credentials cached under login/, no access keys)
[profile tim-personal]
login_session = arn:aws:iam::693386218621:root
region = eu-west-2
output = json

