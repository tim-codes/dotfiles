<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.tim.squad-broker</string>

  <!-- The squad broker (~/dev/squad): holds topic state and the member
       roster, and pushes changes into Claude Code sessions' inboxes. It must
       not be a child of any Claude session (Claude Code treats a
       descendant's inbox writes as self-sent), which a launchd agent
       guarantees. Kept alive and restarted after a crash; the roster is on
       disk, so a restart loses nothing. Logs to stderr only, hence the
       files below. Absolute paths: launchd does no ~ or $HOME expansion. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/tim/.cargo/bin/squad</string>
    <string>broker</string>
  </array>

  <!-- launchd's PATH is bare. /usr/sbin is needed for sysctl (the host
       watcher's memory-pressure read); the quota watcher calls
       /usr/bin/security by absolute path. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/Users/tim/.cargo/bin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <!-- ~/.local/state/squad must exist before bootstrap: launchd does not
       create the parent directory of these files. -->
  <key>StandardOutPath</key>
  <string>/Users/tim/.local/state/squad/broker.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/tim/.local/state/squad/broker.log</string>
</dict>
</plist>
