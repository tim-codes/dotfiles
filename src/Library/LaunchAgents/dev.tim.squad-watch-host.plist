<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.tim.squad-watch-host</string>

  <!-- Host watcher: samples CPU, memory pressure and per-member process
       trees every 5s and publishes the host gauge and host.pressure events.
       No ordering against the broker is needed: if the broker is not up yet
       the watcher reconnects with backoff, and KeepAlive restarts it if it
       exits. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/tim/.cargo/bin/squad</string>
    <string>watch</string>
    <string>host</string>
  </array>

  <!-- launchd's PATH is bare. /usr/sbin is needed for sysctl (the host
       watcher's memory-pressure read); the quota watcher calls
       /usr/bin/security by absolute path. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/Users/tim/.cargo/bin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <!-- ~/.local/state/squad must exist before bootstrap: launchd does not
       create the parent directory of these files. -->
  <key>StandardOutPath</key>
  <string>/Users/tim/.local/state/squad/watch-host.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/tim/.local/state/squad/watch-host.log</string>
</dict>
</plist>
