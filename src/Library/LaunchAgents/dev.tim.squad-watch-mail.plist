<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.tim.squad-watch-mail</string>

  <!-- Mail watcher: supervises one `agent-tooling mail serve` child that
       polls tim@ and claude@ and executes sends, publishing mail.*.inbound
       events and the mail.<mailbox> gauges. Optional: it is not in the
       doctor's required job list, and does nothing useful until
       [[watchers]] name = "mail" is in config.toml and
       ~/.config/squad/liaison.toml exists. No ordering against the broker is
       needed: the watcher reconnects with backoff, and KeepAlive restarts it
       if it exits.

       Credentials: this plist carries none. It runs the wrapper
       ~/bin/squad-watch-mail-launch, which reads a 1Password service-account
       token from the login Keychain (item tim-squad-op-sa), exports it as
       OP_SERVICE_ACCOUNT_TOKEN and execs `squad watch mail`; the mail child
       (agent-run -> agent-tooling mail serve) resolves GRAPH_MAIL_* through
       it. With no Keychain item the wrapper exits 78 and launchd marks the
       job failed. Bootstrap by hand; do not load this until the item and the
       agent.env references exist. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/tim/bin/squad-watch-mail-launch</string>
  </array>

  <!-- launchd's PATH is bare: agent-run and agent-tooling (pnpm
       globals), op and squad are found via the pnpm, homebrew and cargo dirs. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/Users/tim/.cargo/bin:/Users/tim/Library/pnpm/bin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <!-- ~/.local/state/squad must exist before bootstrap: launchd does not
       create the parent directory of these files. -->
  <key>StandardOutPath</key>
  <string>/Users/tim/.local/state/squad/watch-mail.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/tim/.local/state/squad/watch-mail.log</string>
</dict>
</plist>
